# Shared git config (macOS + Linux).
# Delta colors come from themes/tokyo-night-storm/palette.sh — update both
# together when tweaking the palette.
[include]
	path = ~/.config/git/identity
[init]
	defaultBranch = master
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = TwoDark
	minus-style = syntax "#3a1528"
	minus-emph-style = syntax "#6b2038"
	plus-style = syntax "#1a3a1a"
	plus-emph-style = syntax "#2a5a2a"
	line-numbers-minus-style = "#f7768e"
	line-numbers-plus-style = "#9ece6a"
	line-numbers-zero-style = "#414868"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = blue box
	file-style = "#e0af68" bold
	file-decoration-style = "#e0af68" ul
[merge]
	conflictstyle = diff3
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
