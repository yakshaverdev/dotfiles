{
  "respectGitignore": true,
  "skipDangerousModePermissionPrompt": true,
  "autoUpdatesChannel": "stable",
  "theme": "dark-ansi",
  "enabledPlugins": {
    "avoid-ai-writing@conorbronsdon-skills": true,
    "clangd-lsp@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "humanizer@humanizer": true,
    "mattpocock-skills@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "ponytail@ponytail": true,
    "pstack@pstack-claude": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "conorbronsdon-skills": {
      "source": {
        "source": "github",
        "repo": "conorbronsdon/avoid-ai-writing"
      }
    }
  },
  "agentPushNotifEnabled": true,
  "autoContinueAtUsageLimit": false,
  "autoCompactWindow": 400000,
  "effortLevel": "medium",
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-ctx __statusline"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/skills/impeccable/scripts/impeccable\" ] || \"$HOME/.claude/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-ctx __limit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
