#!/usr/bin/env bash
# dots secret — manage env vars and API keys for both machines in one place.
#
# Values live in a self-hosted Infisical project (folders /shared, /agents,
# /mac, /vps) and are mirrored into:
#
#   ~/.config/dot/secrets.zsh   exported by ~/.zshrc (shells + agent tools)
#   ~/.config/dot/secrets.env   systemd EnvironmentFile (T3 Code unit)
#
# Credentials live in ~/.config/dot/infisical.env (mode 600) and are never
# printed. Secret values are only printed by `dots secret get`.
#
# Security notes:
#   - secret values reach curl/jq only via stdin or mode-600 temp files;
#     they never appear in a process list.
#   - bearer tokens are passed to curl through a mode-600 config file.
#   - every file this script writes is created with umask 077 and renamed
#     into place atomically.
set -euo pipefail
umask 077

# ── Resolve the repo from this script's real path ──────────────────────────
resolve_realpath() {
  local p="$1" d
  while [[ -L "$p" ]]; do
    d="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" != /* ]] && p="$d/$p"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
  SELF="$(readlink -f "${BASH_SOURCE[0]}")"
else
  SELF="$(resolve_realpath "${BASH_SOURCE[0]}")"
fi
DOTFILES="$(cd "$(dirname "$SELF")/.." && pwd)"

case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux)  OS=linux ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dot"
CREDS_FILE="$CONFIG_DIR/infisical.env"
TOKEN_FILE="$CONFIG_DIR/.token"
SECRETS_ZSH="$CONFIG_DIR/secrets.zsh"
SECRETS_ENV="$CONFIG_DIR/secrets.env"
SECRETS_SYNCED="$CONFIG_DIR/secrets.synced"
SECRETS_NAMES="$CONFIG_DIR/secrets.names"
HOSTS_FILE="$DOTFILES/config/hosts"
CONTEXTS_FILE="$DOTFILES/config/contexts"
CTX_DIR="$CONFIG_DIR/ctx"

CTX=""
CTX_INDEX=0
CONTEXTS_LOADED=0
CONTEXT_NAMES=()
CONTEXT_PROJECTS=()
CONTEXT_MODES=()
CONTEXT_PATTERNS=()

QUIET=0
TMPD="$(mktemp -d "${TMPDIR:-/tmp}/dots-secret.XXXXXX")"
cleanup() { rm -rf -- "$TMPD"; }
trap cleanup EXIT

# ── Small helpers ──────────────────────────────────────────────────────────
info() { (( QUIET )) || printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err()  { printf 'ERROR: %s\n' "$*" >&2; }

need() {
  command -v "$1" >/dev/null 2>&1 || { err "required command not found: $1"; exit 1; }
}

file_mode() {
  if [[ "$OS" == darwin ]]; then
    stat -f '%Lp' "$1" 2>/dev/null || true
  else
    stat -c '%a' "$1" 2>/dev/null || true
  fi
}

file_mtime() {
  if [[ "$OS" == darwin ]]; then
    stat -f '%m' "$1" 2>/dev/null || true
  else
    stat -c '%Y' "$1" 2>/dev/null || true
  fi
}

tildify() {
  case "$1" in
    "$HOME"/*) printf '~%s\n' "${1#"$HOME"}" ;;
    *)         printf '%s\n' "$1" ;;
  esac
}

valid_name() { [[ "$1" =~ ^[A-Z_][A-Z0-9_]*$ ]]; }

valid_scope() {
  case "$1" in
    shared|agents|mac|vps) return 0 ;;
    *) return 1 ;;
  esac
}

scope_path() { printf '/%s\n' "$1"; }

urlenc() { jq -rn --arg v "$1" '$v|@uri'; }

api_message() { jq -r '.message // empty' "$1" 2>/dev/null || true; }

# ── Credentials (never printed) ────────────────────────────────────────────
INFISICAL_DOMAIN="${INFISICAL_DOMAIN:-}"
INFISICAL_PROJECT_ID="${INFISICAL_PROJECT_ID:-}"
INFISICAL_ENV="${INFISICAL_ENV:-prod}"
INFISICAL_UA_CLIENT_ID="${INFISICAL_UA_CLIENT_ID:-}"
INFISICAL_UA_CLIENT_SECRET="${INFISICAL_UA_CLIENT_SECRET:-}"
DOT_MACHINE="${DOT_MACHINE:-}"
CREDS_LOADED=0
ACCESS_TOKEN="${ACCESS_TOKEN:-}"

unquote_value() {
  local v="$1"
  if [[ "$v" == \"*\" && ${#v} -ge 2 ]]; then
    v="${v#\"}"
    v="${v%\"}"
  elif [[ "$v" == \'*\' && ${#v} -ge 2 ]]; then
    v="${v#\'}"
    v="${v%\'}"
  fi
  printf '%s' "$v"
}

load_creds() {
  if (( CREDS_LOADED )); then return 0; fi
  if [[ ! -f "$CREDS_FILE" ]]; then
    err "missing $CREDS_FILE (see README › Secrets)"
    return 1
  fi
  local line name value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#export }"
    [[ "$line" == *=* ]] || continue
    name="${line%%=*}"
    name="${name//[[:space:]]/}"
    value="$(unquote_value "${line#*=}")"
    case "$name" in
      INFISICAL_DOMAIN)          INFISICAL_DOMAIN="$value" ;;
      INFISICAL_PROJECT_ID)      INFISICAL_PROJECT_ID="$value" ;;
      INFISICAL_ENV)             INFISICAL_ENV="$value" ;;
      INFISICAL_UA_CLIENT_ID)    INFISICAL_UA_CLIENT_ID="$value" ;;
      INFISICAL_UA_CLIENT_SECRET) INFISICAL_UA_CLIENT_SECRET="$value" ;;
      DOT_MACHINE)               DOT_MACHINE="$value" ;;
    esac
  done < "$CREDS_FILE"

  if [[ -z "$INFISICAL_DOMAIN" || -z "$INFISICAL_PROJECT_ID" \
        || -z "$INFISICAL_UA_CLIENT_ID" || -z "$INFISICAL_UA_CLIENT_SECRET" ]]; then
    err "$CREDS_FILE is missing required Infisical keys"
    return 1
  fi
  [[ -n "$INFISICAL_ENV" ]] || INFISICAL_ENV=prod
  CREDS_LOADED=1
  return 0
}

# Folder this machine owns. macbook → /mac, vps → /vps.
machine_folder() {
  local m="${DOT_MACHINE:-}"
  if [[ -z "$m" ]]; then
    case "$OS" in
      darwin) m=macbook ;;
      linux)  m=vps ;;
    esac
  fi
  case "$m" in
    macbook|mac) printf 'mac\n' ;;
    vps)         printf 'vps\n' ;;
    *) err "unknown DOT_MACHINE '$m' (expected macbook or vps)"; return 1 ;;
  esac
}

# ── Client contexts ────────────────────────────────────────────────────────
# config/contexts: name project-id mode patterns...
load_contexts() {
  if (( CONTEXTS_LOADED )); then return 0; fi
  CONTEXTS_LOADED=1
  [[ -f "$CONTEXTS_FILE" ]] || return 0
  local line name project mode patterns
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    read -r name project mode patterns <<< "$line"
    [[ -n "$name" && -n "$project" ]] || continue
    if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
      warn "ignoring context with invalid name '$name'"
      continue
    fi
    case "$mode" in
      strict|merge) ;;
      *) mode=merge ;;
    esac
    CONTEXT_NAMES+=("$name")
    CONTEXT_PROJECTS+=("$project")
    CONTEXT_MODES+=("$mode")
    CONTEXT_PATTERNS+=("${patterns:-}")
  done < "$CONTEXTS_FILE"
  return 0
}

ctx_index() {
  local i
  load_contexts
  for ((i = 0; i < ${#CONTEXT_NAMES[@]}; i++)); do
    if [[ "${CONTEXT_NAMES[i]}" == "$1" ]]; then
      CTX_INDEX=$i
      return 0
    fi
  done
  return 1
}

ctx_project() {
  ctx_index "$1" || return 1
  printf '%s\n' "${CONTEXT_PROJECTS[CTX_INDEX]}"
}

ctx_mode() {
  ctx_index "$1" || return 1
  printf '%s\n' "${CONTEXT_MODES[CTX_INDEX]}"
}

ctx_zsh_file() { printf '%s/%s.zsh\n' "$CTX_DIR" "$1"; }
ctx_names_file() { printf '%s/%s.names\n' "$CTX_DIR" "$1"; }

# Resolve DIR to a context name (or "personal") by matching origin in file order.
context_for_dir() {
  local dir="${1:-$PWD}" top url i pat
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$top" ]]; then
    printf 'personal\n'
    return 0
  fi
  url="$(git -C "$top" config --get remote.origin.url 2>/dev/null || true)"
  if [[ -z "$url" ]]; then
    printf 'personal\n'
    return 0
  fi
  load_contexts
  local -a pats=()
  for ((i = 0; i < ${#CONTEXT_NAMES[@]}; i++)); do
    pats=()
    read -r -a pats <<< "${CONTEXT_PATTERNS[i]}"
    if (( ${#pats[@]} == 0 )); then continue; fi
    for pat in "${pats[@]}"; do
      # shellcheck disable=SC2053  # RHS is a deliberate shell glob
      if [[ "$url" == $pat ]]; then
        printf '%s\n' "${CONTEXT_NAMES[i]}"
        return 0
      fi
    done
  done
  printf 'personal\n'
}

# ── Token cache ────────────────────────────────────────────────────────────
read_cached_token() {
  [[ -f "$TOKEN_FILE" ]] || return 1
  local expiry="" tok=""
  { IFS= read -r expiry || true; IFS= read -r tok || true; } < "$TOKEN_FILE"
  [[ "$expiry" =~ ^[0-9]+$ ]] || return 1
  [[ -n "$tok" ]] || return 1
  (( expiry > $(date +%s) + 60 )) || return 1
  ACCESS_TOKEN="$tok"
  return 0
}

write_token_cache() {
  local tok="$1" ttl="$2" now exp tmp
  now="$(date +%s)"
  exp=$((now + ttl))
  tmp="$(mktemp "$CONFIG_DIR/.token.XXXXXX")"
  printf '%s\n%s\n' "$exp" "$tok" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$TOKEN_FILE"
}

api_login() {
  local body="$TMPD/login.req" out="$TMPD/login.res" code ttl
  mkdir -p "$CONFIG_DIR"
  printf '%s\0%s' "$INFISICAL_UA_CLIENT_ID" "$INFISICAL_UA_CLIENT_SECRET" \
    | jq -Rs 'split("\u0000") | {clientId: .[0], clientSecret: .[1]}' > "$body"

  if ! code="$(curl -sS -o "$out" -w '%{http_code}' -X POST \
        --url "${INFISICAL_DOMAIN%/}/api/v1/auth/universal-auth/login" \
        --header 'Content-Type: application/json' \
        --data-binary @- < "$body")"; then
    rm -f "$body"
    err "Infisical login request failed (network error)"
    return 1
  fi
  rm -f "$body"

  if [[ "$code" != 200 ]]; then
    err "Infisical login failed (HTTP $code): $(api_message "$out")"
    return 1
  fi

  ACCESS_TOKEN="$(jq -r '.accessToken // empty' "$out")"
  if [[ -z "$ACCESS_TOKEN" ]]; then
    err "Infisical login returned no access token"
    return 1
  fi
  ttl="$(jq -r '.expiresIn // 0' "$out")"
  if [[ ! "$ttl" =~ ^[0-9]+$ ]] || (( ttl <= 120 )); then
    ttl=3600
  fi
  write_token_cache "$ACCESS_TOKEN" "$ttl"
  return 0
}

ensure_token() {
  [[ -n "$ACCESS_TOKEN" ]] && return 0
  if read_cached_token; then return 0; fi
  api_login
}

# ── API plumbing ───────────────────────────────────────────────────────────
# Writes the bearer token to a mode-600 curl config (never argv) and feeds the
# request body via stdin from a mode-600 file in $TMPD (never argv).
api_request() {
  local method="$1" path="$2" bodyfile="$3" outfile="$4" cfg tok
  cfg="$TMPD/curl.cfg"
  tok="${ACCESS_TOKEN//\\/\\\\}"
  tok="${tok//\"/\\\"}"
  printf 'header = "Authorization: Bearer %s"\n' "$tok" > "$cfg"
  chmod 600 "$cfg"
  local -a args=(-sS -X "$method" --config "$cfg" -o "$outfile" \
    -w '%{http_code}' --url "${INFISICAL_DOMAIN%/}${path}")
  if [[ -n "$bodyfile" ]]; then
    args+=(--header 'Content-Type: application/json' --data-binary @-)
    curl "${args[@]}" < "$bodyfile"
  else
    curl "${args[@]}"
  fi
}

# Sets HTTP_CODE. Retries once on 401 after dropping a stale cached token.
api_call() {
  local method="$1" path="$2" bodyfile="$3" outfile="$4" attempt=0
  while :; do
    ensure_token || return 1
    if ! HTTP_CODE="$(api_request "$method" "$path" "$bodyfile" "$outfile")"; then
      HTTP_CODE=000
      return 1
    fi
    if [[ "$HTTP_CODE" == 401 && $attempt -eq 0 ]]; then
      ACCESS_TOKEN=""
      rm -f "$TOKEN_FILE"
      attempt=1
      continue
    fi
    return 0
  done
}

# Fetch one secret path into a JSON object {NAME: value}. Missing folders are
# empty. project/path are explicit so personal scopes and client contexts can
# share the same plumbing.
fetch_path() {
  local project="$1" spath="$2" dest="$3" view="${4:-true}" raw url
  raw="$(mktemp "$TMPD/raw.XXXXXX")"
  url="/api/v4/secrets?projectId=$(urlenc "$project")"
  url+="&environment=$(urlenc "$INFISICAL_ENV")"
  url+="&secretPath=$(urlenc "$spath")"
  url+="&viewSecretValue=${view}"

  if ! api_call GET "$url" "" "$raw"; then
    rm -f "$raw"
    err "could not reach Infisical"
    return 1
  fi
  case "$HTTP_CODE" in
    200)
      if ! jq '(.secrets // []) | map({key: .secretKey, value: (.secretValue // "")}) | from_entries' \
            "$raw" > "$dest"; then
        rm -f "$raw"
        return 1
      fi
      ;;
    404)
      printf '{}\n' > "$dest"
      ;;
    *)
      err "could not read $spath (HTTP $HTTP_CODE): $(api_message "$raw")"
      rm -f "$raw"
      return 2
      ;;
  esac
  rm -f "$raw"
  return 0
}

fetch_folder() {
  fetch_path "$INFISICAL_PROJECT_ID" "$(scope_path "$1")" "$2" "${3:-true}"
}

fetch_ctx() {
  local project
  project="$(ctx_project "$1")" || { err "unknown context '$1'"; return 1; }
  fetch_path "$project" "/" "$2" "${3:-true}"
}

secret_upsert() {
  local name="$1" project="$2" spath="$3" value="$4"
  local body="$TMPD/upsert.json" out="$TMPD/upsert.res" path
  printf '%s' "$value" | jq -Rs \
    --arg projectId "$project" \
    --arg environment "$INFISICAL_ENV" \
    --arg secretPath "$spath" \
    --arg type shared \
    '{projectId:$projectId, environment:$environment, secretPath:$secretPath,
      secretValue: ., type:$type}' > "$body"
  path="/api/v4/secrets/$(urlenc "$name")"

  if ! api_call POST "$path" "$body" "$out"; then
    err "could not reach Infisical"
    return 1
  fi
  case "$HTTP_CODE" in
    200|201)
      return 0
      ;;
    400|409)
      # Already exists → update in place.
      if ! api_call PATCH "$path" "$body" "$out"; then
        err "could not reach Infisical"
        return 1
      fi
      case "$HTTP_CODE" in
        200|201) return 0 ;;
        *)
          err "failed to update $name (HTTP $HTTP_CODE): $(api_message "$out")"
          return 1
          ;;
      esac
      ;;
    *)
      err "failed to create $name (HTTP $HTTP_CODE): $(api_message "$out")"
      return 1
      ;;
  esac
}

secret_delete() {
  local name="$1" project="$2" spath="$3"
  local body="$TMPD/delete.json" out="$TMPD/delete.res" path
  jq -n --arg projectId "$project" \
        --arg environment "$INFISICAL_ENV" \
        --arg secretPath "$spath" \
        '{projectId:$projectId, environment:$environment, secretPath:$secretPath}' > "$body"
  path="/api/v4/secrets/$(urlenc "$name")"

  if ! api_call DELETE "$path" "$body" "$out"; then
    err "could not reach Infisical"
    return 1
  fi
  case "$HTTP_CODE" in
    200|204) return 0 ;;
    404)
      err "$name does not exist in $spath"
      return 1
      ;;
    *)
      err "failed to delete $name (HTTP $HTTP_CODE): $(api_message "$out")"
      return 1
      ;;
  esac
}

# ── Value input (never from argv) ──────────────────────────────────────────
VALUE=""

read_value() {
  local name="$1" clip="$2" from_file="$3" use_stdin="$4"
  if (( clip )); then
    if [[ "$OS" != darwin ]]; then
      err "--clip is only available on macOS; use --from-file or --stdin"
      return 1
    fi
    need pbpaste
    VALUE="$(pbpaste)"
  elif [[ -n "$from_file" ]]; then
    if [[ ! -r "$from_file" ]]; then
      err "cannot read $from_file"
      return 1
    fi
    VALUE="$(cat < "$from_file")"
  elif (( use_stdin )); then
    VALUE="$(cat)"
  else
    if [[ ! -r /dev/tty ]]; then
      err "no terminal for the hidden prompt; use --stdin or --from-file"
      return 1
    fi
    printf 'Value for %s: ' "$name" >&2
    IFS= read -rs VALUE < /dev/tty || true
    printf '\n' >&2
  fi
  return 0
}

# ── sync ───────────────────────────────────────────────────────────────────
sync_help() {
  cat <<'EOF'
Usage: dots secret sync [--quiet] [--reload]

Fetch /shared, /agents and this machine's folder from Infisical and write
~/.config/dot/secrets.zsh and ~/.config/dot/secrets.env atomically. Also
refreshes ~/.config/dot/ctx/<name>.{zsh,names} for every client context.
Precedence within personal secrets: machine folder > /agents > /shared.

Options:
  --quiet    Only print warnings and errors
  --reload   Restart consumers after syncing (same as: dots secret reload)
  -h,--help  Show this help

If Infisical is unreachable the previous files are kept; the command exits 0
when they exist and 1 when this machine has never synced.
EOF
}

write_secrets_files() {
  local merged="$1" zsh_tmp env_tmp names_tmp synced_tmp count=0 skipped=0 invalid=0 expected
  local k v esc
  expected="$(jq 'length' "$merged")" || { err "could not read merged secrets"; return 1; }
  [[ "$expected" =~ ^[0-9]+$ ]] || { err "merged secrets are not a JSON array"; return 1; }
  zsh_tmp="$(mktemp "$CONFIG_DIR/.secrets.zsh.XXXXXX")"
  env_tmp="$(mktemp "$CONFIG_DIR/.secrets.env.XXXXXX")"
  names_tmp="$(mktemp "$CONFIG_DIR/.secrets.names.XXXXXX")"

  while IFS= read -r -d '' k && IFS= read -r -d '' v; do
    if ! valid_name "$k"; then
      warn "ignoring secret with unsafe name '$k'"
      invalid=$((invalid + 1))
      continue
    fi
    count=$((count + 1))
    printf '%s\n' "$k" >> "$names_tmp"

    esc="${v//\'/\'\\\'\'}"
    printf "export %s='%s'\n" "$k" "$esc" >> "$zsh_tmp"

    if [[ "$v" == *$'\n'* ]]; then
      warn "secret $k contains a newline — skipped in secrets.env"
      skipped=$((skipped + 1))
    else
      esc="$(printf '%s' "$v" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/\\$/g')"
      printf '%s="%s"\n' "$k" "$esc" >> "$env_tmp"
    fi
  done < <(jq -j '.[] | .key, "\u0000", .value, "\u0000"' "$merged")

  if (( count + invalid != expected )); then
    err "refusing to write secrets files (parsed $((count + invalid)) of $expected entries)"
    rm -f "$zsh_tmp" "$env_tmp" "$names_tmp"
    return 1
  fi

  chmod 600 "$zsh_tmp" "$env_tmp" "$names_tmp"
  mv -f "$zsh_tmp" "$SECRETS_ZSH"
  mv -f "$env_tmp" "$SECRETS_ENV"
  mv -f "$names_tmp" "$SECRETS_NAMES"

  synced_tmp="$(mktemp "$CONFIG_DIR/.secrets.synced.XXXXXX")"
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$count" > "$synced_tmp"
  chmod 600 "$synced_tmp"
  mv -f "$synced_tmp" "$SECRETS_SYNCED"

  if (( skipped > 0 )); then
    info "✓ synced $count secret(s) ($skipped skipped in secrets.env)"
  else
    info "✓ synced $count secret(s)"
  fi
}

# Write one context cache: ctx/<name>.zsh + ctx/<name>.names, atomically.
write_ctx_files() {
  local name="$1" merged="$2" zsh_tmp names_tmp count=0 invalid=0 expected k v esc
  expected="$(jq 'length' "$merged")" || { err "could not read context $name secrets"; return 1; }
  [[ "$expected" =~ ^[0-9]+$ ]] || { err "context $name secrets are not a JSON array"; return 1; }
  mkdir -p "$CTX_DIR"
  zsh_tmp="$(mktemp "$CTX_DIR/.$name.zsh.XXXXXX")"
  names_tmp="$(mktemp "$CTX_DIR/.$name.names.XXXXXX")"

  while IFS= read -r -d '' k && IFS= read -r -d '' v; do
    if ! valid_name "$k"; then
      warn "context $name: ignoring secret with unsafe name '$k'"
      invalid=$((invalid + 1))
      continue
    fi
    count=$((count + 1))
    printf '%s\n' "$k" >> "$names_tmp"
    esc="${v//\'/\'\\\'\'}"
    printf "export %s='%s'\n" "$k" "$esc" >> "$zsh_tmp"
  done < <(jq -j 'to_entries | sort_by(.key) | .[] | .key, "\u0000", .value, "\u0000"' "$merged")

  if (( count + invalid != expected )); then
    err "refusing to write context $name cache (parsed $((count + invalid)) of $expected entries)"
    rm -f "$zsh_tmp" "$names_tmp"
    return 1
  fi

  chmod 600 "$zsh_tmp" "$names_tmp"
  mv -f "$zsh_tmp" "$(ctx_zsh_file "$name")"
  mv -f "$names_tmp" "$(ctx_names_file "$name")"
  return 0
}

# Context caches are independent: a failure keeps that context's old files.
sync_contexts() {
  load_contexts
  if (( ${#CONTEXT_NAMES[@]} == 0 )); then return 0; fi
  mkdir -p "$CTX_DIR"
  local i name raw
  for ((i = 0; i < ${#CONTEXT_NAMES[@]}; i++)); do
    name="${CONTEXT_NAMES[i]}"
    raw="$TMPD/ctx-$name.json"
    if ! fetch_ctx "$name" "$raw" true; then
      warn "context $name sync failed — keeping existing ctx/$name files"
      continue
    fi
    if ! write_ctx_files "$name" "$raw"; then
      warn "context $name sync failed — keeping existing ctx/$name files"
    fi
  done
  return 0
}

cmd_sync() {
  local do_reload=0
  while (($#)); do
    case "$1" in
      --quiet|-q) QUIET=1; shift ;;
      --reload)   do_reload=1; shift ;;
      --no-peer)  shift ;;  # sync never contacts peers; accepted for parity
      -h|--help)  sync_help; return 0 ;;
      *) err "unknown option for sync: $1"; sync_help >&2; return 1 ;;
    esac
  done

  need jq
  need curl
  load_creds || return 1

  local mf shared agents machine merged
  mf="$(machine_folder)" || return 1
  mkdir -p "$CONFIG_DIR"

  shared="$TMPD/shared.json"
  agents="$TMPD/agents.json"
  machine="$TMPD/machine.json"
  merged="$TMPD/merged.json"

  if ! fetch_folder shared "$shared" true; then
    warn "Infisical unreachable — keeping existing secrets files"
    if [[ -f "$SECRETS_ZSH" && -f "$SECRETS_ENV" ]]; then return 0; fi
    return 1
  fi
  if ! fetch_folder agents "$agents" true; then
    warn "Infisical unreachable — keeping existing secrets files"
    if [[ -f "$SECRETS_ZSH" && -f "$SECRETS_ENV" ]]; then return 0; fi
    return 1
  fi
  if ! fetch_folder "$mf" "$machine" true; then
    warn "Infisical unreachable — keeping existing secrets files"
    if [[ -f "$SECRETS_ZSH" && -f "$SECRETS_ENV" ]]; then return 0; fi
    return 1
  fi

  if ! jq -s '((.[0] // {}) * (.[1] // {}) * (.[2] // {})) | to_entries | sort_by(.key)' \
        "$shared" "$agents" "$machine" > "$merged"; then
    err "failed to merge secrets"
    return 1
  fi

  write_secrets_files "$merged"
  sync_contexts

  if (( do_reload )); then cmd_reload; fi
  return 0
}

# ── peer sync ──────────────────────────────────────────────────────────────
peer_sync() {
  if [[ ! -f "$HOSTS_FILE" ]]; then
    warn "no $HOSTS_FILE — skipping peer sync"
    return 0
  fi
  local machine target repo
  while read -r machine target repo || [[ -n "${machine:-}" ]]; do
    [[ -z "$machine" || "$machine" == \#* ]] && continue
    [[ -n "$target" ]] || continue
    [[ "$machine" == "${DOT_MACHINE:-}" ]] && continue
    # shellcheck disable=SC2034  # repo is documentation only; the peer
    # computes its own repo path from ~/.local/bin/dots.
    : "$repo"
    if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$target" \
          '"$HOME/.local/bin/dots" secret sync --quiet'; then
      warn "peer $machine sync failed — peer will catch up on its next scheduled sync"
    fi
  done < "$HOSTS_FILE"
  return 0
}

# ── set ────────────────────────────────────────────────────────────────────
set_help() {
  cat <<'EOF'
Usage: dots secret set NAME [options]

Upsert NAME in Infisical, then sync this machine (and the peer unless
--no-peer). The value is never read from the command line.

Options:
  --scope shared|agents|mac|vps  Folder to write (default: shared)
  --ctx NAME                     Client context project (path /); no --scope
  --clip                         Read the value from the macOS clipboard
  --from-file FILE               Read the value from FILE
  --stdin                        Read the value from stdin
  --no-peer                      Do not sync the other machine
  --reload                       Restart consumers after syncing
  -h,--help                      Show this help

Without --clip/--from-file/--stdin the value is read with a hidden prompt.
NAME must match ^[A-Z_][A-Z0-9_]*$.

Examples:
  dots secret set OPENAI_API_KEY --scope agents
  dots secret set GH_TOKEN --clip
  printf '%s' "$KEY" | dots secret set SENTRY_AUTH_TOKEN --stdin
EOF
}

cmd_set() {
  local name="" scope=shared scope_set=0 clip=0 from_file="" use_stdin=0
  local no_peer=0 do_reload=0 project spath
  while (($#)); do
    case "$1" in
      --scope)     [[ $# -ge 2 ]] || { err "--scope needs a value"; return 1; }
                   scope="$2"; scope_set=1; shift 2 ;;
      --scope=*)   scope="${1#*=}"; scope_set=1; shift ;;
      --clip)      clip=1; shift ;;
      --from-file) [[ $# -ge 2 ]] || { err "--from-file needs a value"; return 1; }
                   from_file="$2"; shift 2 ;;
      --from-file=*) from_file="${1#*=}"; shift ;;
      --stdin)     use_stdin=1; shift ;;
      --no-peer)   no_peer=1; shift ;;
      --reload)    do_reload=1; shift ;;
      -h|--help)   set_help; return 0 ;;
      -*)          err "unknown option for set: $1"; set_help >&2; return 1 ;;
      *)
        if [[ -n "$name" ]]; then err "set takes one NAME"; return 1; fi
        name="$1"; shift ;;
    esac
  done

  if [[ -z "$name" ]]; then err "set requires NAME"; set_help >&2; return 1; fi
  if ! valid_name "$name"; then
    err "invalid NAME '$name' (must match ^[A-Z_][A-Z0-9_]*$)"
    return 1
  fi

  need jq
  need curl
  load_creds || return 1

  if [[ -n "$CTX" ]]; then
    if (( scope_set )); then
      err "--scope cannot be used with --ctx"; return 1
    fi
    project="$(ctx_project "$CTX")" || { err "unknown context '$CTX'"; return 1; }
    spath="/"
  else
    if ! valid_scope "$scope"; then
      err "invalid scope '$scope' (shared|agents|mac|vps)"
      return 1
    fi
    project="$INFISICAL_PROJECT_ID"
    spath="$(scope_path "$scope")"
  fi
  if (( clip )) && [[ -n "$from_file" ]]; then
    err "choose only one of --clip, --from-file, --stdin"; return 1
  fi
  if (( clip )) && (( use_stdin )); then
    err "choose only one of --clip, --from-file, --stdin"; return 1
  fi
  if [[ -n "$from_file" ]] && (( use_stdin )); then
    err "choose only one of --clip, --from-file, --stdin"; return 1
  fi

  read_value "$name" "$clip" "$from_file" "$use_stdin" || return 1

  secret_upsert "$name" "$project" "$spath" "$VALUE" || return 1
  if [[ -n "$CTX" ]]; then
    info "✓ $name set in context $CTX"
  else
    info "✓ $name set in /$scope"
  fi

  if ! cmd_sync; then
    warn "secret saved but local sync failed (run: dots secret sync)"
  fi
  if (( ! no_peer )); then peer_sync; fi
  if (( do_reload )); then cmd_reload; fi
  return 0
}

# ── get ────────────────────────────────────────────────────────────────────
get_help() {
  cat <<'EOF'
Usage: dots secret get NAME [--scope shared|agents|mac|vps] [--copy]

Print one value to stdout, or copy it to the clipboard with --copy.

Without --scope, precedence is: this machine's folder > agents > shared.

--copy uses pbcopy on macOS and an OSC 52 escape on Linux (supported by most
modern terminals; may need tmux's set-clipboard on).

Options:
  --scope S    Read only from this folder
  --ctx NAME   Read from a client context project (path /)
  --copy      Copy the value instead of printing it
  -h,--help   Show this help
EOF
}

cmd_get() {
  local name="" scope="" scope_set=0 copy=0
  while (($#)); do
    case "$1" in
      --scope)   [[ $# -ge 2 ]] || { err "--scope needs a value"; return 1; }
                 scope="$2"; scope_set=1; shift 2 ;;
      --scope=*) scope="${1#*=}"; scope_set=1; shift ;;
      --copy)    copy=1; shift ;;
      -h|--help) get_help; return 0 ;;
      -*)        err "unknown option for get: $1"; get_help >&2; return 1 ;;
      *)
        if [[ -n "$name" ]]; then err "get takes one NAME"; return 1; fi
        name="$1"; shift ;;
    esac
  done

  if [[ -z "$name" ]]; then err "get requires NAME"; get_help >&2; return 1; fi
  if ! valid_name "$name"; then err "invalid NAME '$name'"; return 1; fi
  if [[ -n "$scope" ]] && ! valid_scope "$scope"; then
    err "invalid scope '$scope' (shared|agents|mac|vps)"
    return 1
  fi
  if [[ -n "$CTX" ]] && (( scope_set )); then
    err "--scope cannot be used with --ctx"; return 1
  fi

  need jq
  need curl
  load_creds || return 1

  local dest="$TMPD/get.json" value="" s mf label=""
  local -a scopes=()
  if [[ -n "$CTX" ]]; then
    fetch_ctx "$CTX" "$dest" true || return 1
    label="context $CTX"
  else
    if [[ -n "$scope" ]]; then
      scopes=("$scope")
    else
      mf="$(machine_folder)" || return 1
      scopes=("$mf" agents shared)
    fi
    for s in "${scopes[@]}"; do
      fetch_folder "$s" "$dest" true || return 1
      if jq -e --arg n "$name" 'has($n)' "$dest" >/dev/null 2>&1; then
        break
      fi
    done
    label=""
    for s in "${scopes[@]}"; do label+="/$s "; done
    label="${label% }"
  fi

  if jq -e --arg n "$name" 'has($n)' "$dest" >/dev/null 2>&1; then
    value="$(jq -j --arg n "$name" '.[$n] // ""' "$dest")"
  else
    err "$name not found in $label"
    return 1
  fi

  if (( copy )); then
    if [[ "$OS" == darwin ]]; then
      need pbcopy
      printf '%s' "$value" | pbcopy
      info "copied $name to clipboard"
    else
      local b64
      b64="$(printf '%s' "$value" | base64 | tr -d '\n')"
      if [[ -w /dev/tty ]] && printf '\033]52;c;%s\a' "$b64" > /dev/tty 2>/dev/null; then
        info "copied $name to clipboard (OSC 52)"
      else
        err "no terminal available for OSC 52; run without --copy to print"
        return 1
      fi
    fi
  else
    printf '%s\n' "$value"
  fi
  return 0
}

# ── ls ─────────────────────────────────────────────────────────────────────
ls_help() {
  cat <<'EOF'
Usage: dots secret ls [--scope shared|agents|mac|vps]

List secret names and their folder. Values are never printed.

Without --scope all four folders are listed.

Options:
  --scope S    List only this folder
  --ctx NAME   List a client context project (path /)
  -h,--help    Show this help
EOF
}

cmd_ls() {
  local scope="" scope_set=0
  while (($#)); do
    case "$1" in
      --scope)   [[ $# -ge 2 ]] || { err "--scope needs a value"; return 1; }
                 scope="$2"; scope_set=1; shift 2 ;;
      --scope=*) scope="${1#*=}"; scope_set=1; shift ;;
      -h|--help) ls_help; return 0 ;;
      *) err "unknown option for ls: $1"; ls_help >&2; return 1 ;;
    esac
  done
  if [[ -n "$scope" ]] && ! valid_scope "$scope"; then
    err "invalid scope '$scope' (shared|agents|mac|vps)"
    return 1
  fi
  if [[ -n "$CTX" ]] && (( scope_set )); then
    err "--scope cannot be used with --ctx"; return 1
  fi

  need jq
  need curl
  load_creds || return 1

  local -a scopes=()
  local s dest="$TMPD/ls.json" n found=0
  printf '%-40s %s\n' NAME SCOPE
  if [[ -n "$CTX" ]]; then
    fetch_ctx "$CTX" "$dest" false || return 1
    while IFS= read -r n; do
      [[ -n "$n" ]] || continue
      printf '%-40s %s\n' "$n" "ctx:$CTX"
      found=1
    done < <(jq -r 'keys[]' "$dest" | sort)
  else
    if [[ -n "$scope" ]]; then scopes=("$scope"); else scopes=(shared agents mac vps); fi
    for s in "${scopes[@]}"; do
      fetch_folder "$s" "$dest" false || return 1
      while IFS= read -r n; do
        [[ -n "$n" ]] || continue
        printf '%-40s %s\n' "$n" "/$s"
        found=1
      done < <(jq -r 'keys[]' "$dest" | sort)
    done
  fi
  if (( found == 0 )); then info "(no secrets)"; fi
  return 0
}

# ── rm ─────────────────────────────────────────────────────────────────────
rm_help() {
  cat <<'EOF'
Usage: dots secret rm NAME (--scope shared|agents|mac|vps | --ctx NAME) [options]

Delete NAME from one folder or client context, then sync this machine (and
the peer unless --no-peer).

Options:
  --scope S    Folder to delete from (personal; required without --ctx)
  --ctx NAME   Client context project (path /)
  --no-peer    Do not sync the other machine
  --reload     Restart consumers after syncing
  -h,--help    Show this help
EOF
}

cmd_rm() {
  local name="" scope="" scope_set=0 no_peer=0 do_reload=0 project spath
  while (($#)); do
    case "$1" in
      --scope)   [[ $# -ge 2 ]] || { err "--scope needs a value"; return 1; }
                 scope="$2"; scope_set=1; shift 2 ;;
      --scope=*) scope="${1#*=}"; scope_set=1; shift ;;
      --no-peer) no_peer=1; shift ;;
      --reload)  do_reload=1; shift ;;
      -h|--help) rm_help; return 0 ;;
      -*)        err "unknown option for rm: $1"; rm_help >&2; return 1 ;;
      *)
        if [[ -n "$name" ]]; then err "rm takes one NAME"; return 1; fi
        name="$1"; shift ;;
    esac
  done

  if [[ -z "$name" ]]; then err "rm requires NAME"; rm_help >&2; return 1; fi
  if ! valid_name "$name"; then err "invalid NAME '$name'"; return 1; fi

  need jq
  need curl
  load_creds || return 1

  if [[ -n "$CTX" ]]; then
    if (( scope_set )); then
      err "--scope cannot be used with --ctx"; return 1
    fi
    project="$(ctx_project "$CTX")" || { err "unknown context '$CTX'"; return 1; }
    spath="/"
  else
    if [[ -z "$scope" ]]; then
      err "rm requires --scope (shared|agents|mac|vps)"
      return 1
    fi
    if ! valid_scope "$scope"; then
      err "invalid scope '$scope' (shared|agents|mac|vps)"
      return 1
    fi
    project="$INFISICAL_PROJECT_ID"
    spath="$(scope_path "$scope")"
  fi

  secret_delete "$name" "$project" "$spath" || return 1
  if [[ -n "$CTX" ]]; then
    info "✓ $name removed from context $CTX"
  else
    info "✓ $name removed from /$scope"
  fi

  if ! cmd_sync; then
    warn "secret deleted but local sync failed (run: dots secret sync)"
  fi
  if (( ! no_peer )); then peer_sync; fi
  if (( do_reload )); then cmd_reload; fi
  return 0
}

# ── import ─────────────────────────────────────────────────────────────────
import_help() {
  cat <<'EOF'
Usage: dots secret import FILE [--scope shared|agents|mac|vps] [options]

Import dotenv lines (KEY=VALUE, optional "export", quotes and # comments)
into a folder. Existing names are skipped unless --force. Only names are
printed, never values. Then syncs this machine and the peer (unless
--no-peer).

Options:
  --scope S    Folder to import into (default: shared)
  --ctx NAME   Import into a client context project (path /)
  --force     Overwrite names that already exist
  --no-peer   Do not sync the other machine
  --reload    Restart consumers after syncing
  -h,--help   Show this help
EOF
}

cmd_import() {
  local file="" scope=shared scope_set=0 force=0 no_peer=0 do_reload=0 project spath target
  while (($#)); do
    case "$1" in
      --scope)   [[ $# -ge 2 ]] || { err "--scope needs a value"; return 1; }
                 scope="$2"; scope_set=1; shift 2 ;;
      --scope=*) scope="${1#*=}"; scope_set=1; shift ;;
      --force)   force=1; shift ;;
      --no-peer) no_peer=1; shift ;;
      --reload)  do_reload=1; shift ;;
      -h|--help) import_help; return 0 ;;
      -*)        err "unknown option for import: $1"; import_help >&2; return 1 ;;
      *)
        if [[ -n "$file" ]]; then err "import takes one FILE"; return 1; fi
        file="$1"; shift ;;
    esac
  done

  if [[ -z "$file" ]]; then err "import requires FILE"; import_help >&2; return 1; fi
  if [[ ! -r "$file" ]]; then err "cannot read $file"; return 1; fi

  need jq
  need curl
  load_creds || return 1

  if [[ -n "$CTX" ]]; then
    if (( scope_set )); then
      err "--scope cannot be used with --ctx"; return 1
    fi
    project="$(ctx_project "$CTX")" || { err "unknown context '$CTX'"; return 1; }
    spath="/"
    target="context $CTX"
  else
    if ! valid_scope "$scope"; then
      err "invalid scope '$scope' (shared|agents|mac|vps)"
      return 1
    fi
    project="$INFISICAL_PROJECT_ID"
    spath="$(scope_path "$scope")"
    target="/$scope"
  fi

  local existing="$TMPD/existing.txt" dest="$TMPD/import.json"
  if [[ -n "$CTX" ]]; then
    fetch_ctx "$CTX" "$dest" false || return 1
  else
    fetch_folder "$scope" "$dest" false || return 1
  fi
  jq -r 'keys[]' "$dest" > "$existing"

  local imported=0 skipped=0 failed=0
  local line name value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#export }"
    if [[ "$line" != *=* ]]; then
      warn "skipping malformed line"
      continue
    fi
    name="${line%%=*}"
    name="${name%"${name##*[![:space:]]}"}"
    value="${line#*=}"
    value="${value#"${value%%[![:space:]]*}"}"

    if ! valid_name "$name"; then
      warn "skipping '$name' (must match ^[A-Z_][A-Z0-9_]*$)"
      continue
    fi

    if [[ "$value" =~ ^\"((\\.|[^\"\\])*)\" ]]; then
      value="${BASH_REMATCH[1]}"
      value="${value//\\\"/\"}"
      value="${value//\\\\/\\}"
    elif [[ "$value" =~ ^\'([^\']*)\' ]]; then
      value="${BASH_REMATCH[1]}"
    else
      value="${value%%[[:space:]]#*}"
      value="${value%"${value##*[![:space:]]}"}"
    fi

    if (( ! force )) && grep -qxF -- "$name" "$existing"; then
      info "skipped $name"
      skipped=$((skipped + 1))
      continue
    fi
    if secret_upsert "$name" "$project" "$spath" "$value"; then
      info "imported $name"
      printf '%s\n' "$name" >> "$existing"
      imported=$((imported + 1))
    else
      err "failed to import $name"
      failed=$((failed + 1))
    fi
  done < "$file"

  info "import into $target: $imported imported, $skipped skipped, $failed failed"

  if ! cmd_sync; then
    warn "import finished but local sync failed (run: dots secret sync)"
  fi
  if (( ! no_peer )); then peer_sync; fi
  if (( do_reload )); then cmd_reload; fi
  (( failed == 0 ))
}

# ── ctx / run ──────────────────────────────────────────────────────────────
ctx_help() {
  cat <<'EOF'
Usage: dots secret ctx [DIR]

Print the client context for DIR (default: $PWD) by matching the repo's
origin remote against config/contexts. Prints "personal" when no context
matches or DIR is not a git repo.
EOF
}

cmd_ctx() {
  local dir="$PWD" dir_set=0
  while (($#)); do
    case "$1" in
      -h|--help) ctx_help; return 0 ;;
      --) shift; break ;;
      -*) err "unknown option for ctx: $1"; ctx_help >&2; return 1 ;;
      *)
        if (( dir_set )); then err "ctx takes at most one DIR"; return 1; fi
        dir="$1"; dir_set=1; shift ;;
    esac
  done
  if (($#)); then err "ctx takes at most one DIR"; return 1; fi
  context_for_dir "$dir"
}

run_help() {
  cat <<'EOF'
Usage: dots secret run [--ctx NAME] -- CMD [ARGS...]

Run CMD with the secrets for the detected client context (or --ctx NAME).
Without --ctx the context is detected from $PWD via config/contexts.

Strict contexts unset every personal secret before applying the context
values; merge contexts keep personal values and override collisions.
DOT_CTX is exported for client contexts and left unset for personal.
EOF
}

unset_names_from() {
  local f="$1" n
  [[ -r "$f" ]] || return 0
  while IFS= read -r n || [[ -n "$n" ]]; do
    [[ -n "$n" ]] || continue
    [[ "$n" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    unset "$n" 2>/dev/null || true
  done < "$f"
  return 0
}

cmd_run() {
  local -a cmdargs=()
  local sep=0 name zsh
  while (($#)); do
    case "$1" in
      --) shift; cmdargs=("$@"); sep=1; break ;;
      --ctx) [[ $# -ge 2 ]] || { err "--ctx needs a value"; return 1; }
             CTX="$2"; shift 2 ;;
      --ctx=*) CTX="${1#*=}"; shift ;;
      -h|--help) run_help; return 0 ;;
      *) err "run: expected -- before the command"; run_help >&2; return 1 ;;
    esac
  done
  if (( ! sep )) || (( ${#cmdargs[@]} == 0 )); then
    err "run requires: -- CMD [ARGS...]"; run_help >&2
    return 1
  fi

  name="${CTX:-}"
  if [[ -z "$name" ]]; then
    name="$(context_for_dir "$PWD")" || name=personal
  elif [[ "$name" != personal ]]; then
    ctx_project "$name" >/dev/null || { err "unknown context '$name'"; return 1; }
  fi

  if [[ "$name" == personal ]]; then
    exec "${cmdargs[@]}"
  fi

  zsh="$(ctx_zsh_file "$name")"
  if [[ ! -r "$zsh" ]]; then
    warn "context $name cache missing — syncing"
    cmd_sync --quiet || true
  fi
  if [[ ! -r "$zsh" ]]; then
    err "could not sync context $name (run: dots secret sync)"
    return 1
  fi

  if [[ "$(ctx_mode "$name")" == strict ]]; then
    unset_names_from "$SECRETS_NAMES"
  fi
  # shellcheck disable=SC1090
  source "$zsh"
  export DOT_CTX="$name"
  exec "${cmdargs[@]}"
}

# ── reload ─────────────────────────────────────────────────────────────────
reload_help() {
  cat <<'EOF'
Usage: dots secret reload [--force]

Make consumers pick up new values.

Linux: restarts t3code.service unless T3 agent scopes are running (then it
defers; --force restarts anyway).
macOS: --force quits and reopens T3 Code; without it, new shells get the
values immediately and the app picks them up after a restart.

Options:
  --force    Restart even when agent sessions are running
  -h,--help  Show this help
EOF
}

cmd_reload() {
  local force=0
  while (($#)); do
    case "$1" in
      --force)   force=1; shift ;;
      -h|--help) reload_help; return 0 ;;
      *) err "unknown option for reload: $1"; reload_help >&2; return 1 ;;
    esac
  done

  if [[ "$OS" == darwin ]]; then
    if (( force )); then
      osascript -e 'quit app "T3 Code"' 2>/dev/null || true
      local i
      for ((i = 0; i < 40; i++)); do
        pgrep -x "T3 Code" >/dev/null 2>&1 || break
        sleep 0.5
      done
      if ! open -a "T3 Code" 2>/dev/null; then
        warn "could not reopen T3 Code"
      else
        info "restarted T3 Code"
      fi
    else
      info "New values reach new shells now; the T3 Code app picks them up after a restart (dots secret reload --force)."
    fi
    return 0
  fi

  if ! systemctl --user is-active --quiet t3code.service 2>/dev/null; then
    info "t3code.service is not running — new values will be picked up when it starts"
    return 0
  fi

  local count
  count="$(systemctl --user list-units --type=scope --state=running --no-legend \
      't3code-*' 2>/dev/null \
    | awk '{print $1}' \
    | grep -v '^t3code-terminal-' \
    | grep -c . || true)"
  [[ "$count" =~ ^[0-9]+$ ]] || count=0

  if (( count == 0 )) || (( force )); then
    if systemctl --user restart t3code.service; then
      info "restarted t3code.service"
    else
      err "failed to restart t3code.service"
      return 1
    fi
  else
    info "T3 restart deferred: $count agent session(s) running — run \`dots secret reload --force\` to restart now"
  fi
  return 0
}

# ── doctor ─────────────────────────────────────────────────────────────────
doctor_help() {
  cat <<'EOF'
Usage: dots secret doctor

Check the credentials file, Infisical login, folder access, local files and
the periodic sync job. Exits 1 if any check fails.
EOF
}

cmd_doctor() {
  case "${1:-}" in
    -h|--help) doctor_help; return 0 ;;
    "") ;;
    *) err "unknown option for doctor: $1"; doctor_help >&2; return 1 ;;
  esac

  local problems=0 warnings=0
  ok()   { printf '  ✓ %s\n' "$*"; }
  bad()  { printf '  ✗ %s\n' "$*"; problems=$((problems + 1)); }
  note() { printf '  ! %s\n' "$*"; warnings=$((warnings + 1)); }

  printf '=== dots secret doctor (%s) ===\n' "$OS"

  need jq
  need curl

  printf '→ Credentials\n'
  if [[ ! -f "$CREDS_FILE" ]]; then
    bad "$CREDS_FILE missing (see README › Secrets)"
    printf '\n%d problem(s), %d warning(s)\n' "$problems" "$warnings"
    return 1
  fi
  local mode
  mode="$(file_mode "$CREDS_FILE")"
  if [[ "$mode" == 600 ]]; then
    ok "$CREDS_FILE (mode 600)"
  else
    bad "$CREDS_FILE is mode ${mode:-unknown} (expected 600)"
  fi

  printf '→ Infisical\n'
  local login_ok=0
  if ! load_creds; then
    bad "credentials file is incomplete"
  else
    ACCESS_TOKEN=""
    if api_login; then
      ok "login"
      login_ok=1
      local s dest="$TMPD/doctor.json"
      for s in shared agents mac vps; do
        if fetch_folder "$s" "$dest" false; then
          ok "/$s readable"
        else
          bad "/$s unreadable"
        fi
      done
    else
      bad "login failed"
    fi
  fi

  printf '→ Contexts\n'
  load_contexts
  if (( ${#CONTEXT_NAMES[@]} == 0 )); then
    ok "none configured"
  else
    local i cname cf mtime age
    for ((i = 0; i < ${#CONTEXT_NAMES[@]}; i++)); do
      cname="${CONTEXT_NAMES[i]}"
      if (( login_ok )); then
        if fetch_ctx "$cname" "$TMPD/doctor-ctx-$cname.json" false; then
          ok "context $cname reachable"
        else
          bad "context $cname unreachable"
        fi
      fi
      cf="$(ctx_zsh_file "$cname")"
      if [[ -f "$cf" ]]; then
        mtime="$(file_mtime "$cf")"
        if [[ "$mtime" =~ ^[0-9]+$ ]]; then
          age=$(( $(date +%s) - mtime ))
          if (( age > 86400 )); then
            note "ctx/$cname.zsh is ${age}s old (> 1 day)"
          else
            ok "ctx/$cname.zsh (${age}s ago)"
          fi
        else
          ok "ctx/$cname.zsh present"
        fi
      else
        bad "ctx/$cname.zsh missing (run: dots secret sync)"
      fi
    done
  fi

  printf '→ Local files\n'
  local f
  for f in "$SECRETS_ZSH" "$SECRETS_ENV" "$SECRETS_NAMES"; do
    if [[ ! -f "$f" ]]; then
      bad "$(tildify "$f") missing (run: dots secret sync)"
      continue
    fi
    mode="$(file_mode "$f")"
    if [[ "$mode" == 600 ]]; then
      ok "$(tildify "$f") (mode 600)"
    else
      bad "$(tildify "$f") is mode ${mode:-unknown} (expected 600)"
    fi
  done

  if [[ -f "$SECRETS_SYNCED" ]]; then
    local synced_at="" count="" mtime age
    read -r synced_at count _ < "$SECRETS_SYNCED" || true
    mtime="$(file_mtime "$SECRETS_SYNCED")"
    if [[ "$mtime" =~ ^[0-9]+$ ]]; then
      age=$(( $(date +%s) - mtime ))
      if (( age > 86400 )); then
        note "last sync ${synced_at:-unknown} (${age}s ago, > 1 day)"
      else
        ok "last sync ${synced_at:-unknown} (${count:-?} secret(s))"
      fi
    else
      note "could not read the last sync time"
    fi
  else
    bad "$HOME/.config/dot/secrets.synced missing (run: dots secret sync)"
  fi

  printf '→ Periodic sync\n'
  if [[ "$OS" == linux ]]; then
    if systemctl --user is-enabled --quiet dots-secret-sync.timer 2>/dev/null; then
      ok "dots-secret-sync.timer enabled"
    else
      bad "dots-secret-sync.timer not enabled (run: systemctl --user enable --now dots-secret-sync.timer)"
    fi
  else
    if launchctl print "gui/$(id -u)/com.dots.secret-sync" >/dev/null 2>&1; then
      ok "com.dots.secret-sync loaded"
    else
      bad "com.dots.secret-sync not loaded (run: dots install)"
    fi
  fi

  printf '\n'
  if (( problems > 0 )); then
    printf '%d problem(s), %d warning(s)\n' "$problems" "$warnings"
    return 1
  fi
  printf 'All checks passed (%d warning(s))\n' "$warnings"
  return 0
}

# ── main ───────────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
Usage: dots secret [--ctx NAME] <command> [options]

Manage env vars and API keys for both machines via self-hosted Infisical.

Commands:
  set NAME     Add or update a secret (hidden prompt, --clip, --from-file, --stdin)
  get NAME     Print one value, or copy it with --copy
  ls           List names and folders (never values)
  rm NAME      Delete a secret from one folder
  sync         Refresh ~/.config/dot secrets and context caches from Infisical
  import FILE  Import a dotenv file
  ctx [DIR]    Print the client context for DIR (default: $PWD)
  run -- CMD   Run CMD with the detected (or --ctx) context secrets
  reload       Make shells / T3 Code pick up new values
  doctor       Check credentials, access, contexts, files and the sync timer

--ctx NAME may appear before or after the subcommand for set/get/ls/rm/import.
Run `dots secret <command> --help` for details.
EOF
}

main() {
  local -a rest=()
  CTX=""
  while (($#)); do
    case "$1" in
      --ctx)
        if [[ $# -lt 2 ]]; then err "--ctx needs a value"; return 1; fi
        CTX="$2"; shift 2 ;;
      --ctx=*)
        CTX="${1#*=}"; shift ;;
      --)
        rest+=("$@"); break ;;
      *)
        rest+=("$1"); shift ;;
    esac
  done
  if (( ${#rest[@]} )); then set -- "${rest[@]}"; else set --; fi

  load_contexts
  local cmd="${1:-}"
  if (( $# )); then shift; fi
  case "$cmd" in
    set|get|ls|rm|import|run) ;;
    *)
      if [[ -n "$CTX" ]]; then
        err "--ctx is only supported for set, get, ls, rm, import and run"
        return 1
      fi
      ;;
  esac
  case "$cmd" in
    set)    cmd_set "$@" ;;
    get)    cmd_get "$@" ;;
    ls)     cmd_ls "$@" ;;
    rm)     cmd_rm "$@" ;;
    sync)   cmd_sync "$@" ;;
    import) cmd_import "$@" ;;
    ctx)    cmd_ctx "$@" ;;
    run)    cmd_run "$@" ;;
    reload) cmd_reload "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "unknown command: $cmd"; usage >&2; return 1 ;;
  esac
}

main "$@"
