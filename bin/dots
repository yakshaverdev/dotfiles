#!/usr/bin/env bash
# dots — cross-platform dotfiles bootstrap / maintenance CLI.
#
# Works on macOS (darwin) and Ubuntu/Debian (linux). GNU Stow is used to
# symlink packages from stow/<group>/<pkg> into $HOME.
set -euo pipefail

# ── Resolve the repo from this script's real path ──────────────────────────
# macOS's readlink has no -f, so fall back to a portable resolution loop.
resolve_realpath() {
  local p="$1" d
  while [[ -L "$p" ]]; do
    d="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" != /* ]] && p="$d/$p"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
  SELF="$(readlink -f "${BASH_SOURCE[0]}")"
else
  SELF="$(resolve_realpath "${BASH_SOURCE[0]}")"
fi
DOTFILES="$(cd "$(dirname "$SELF")/.." && pwd)"

case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux)  OS=linux ;;
  *) echo "Unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

STOW_GROUPS=(common "$OS")
BACKUP_ROOT="$HOME/.dotfiles-backup"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="$BACKUP_ROOT/$STAMP"
BACKUP_USED=0

FAILURES=()
MANUAL=()

AGENT_SKILLS_MANIFEST="$DOTFILES/packages/agent-skills"
AGENT_PLUGINS_MANIFEST="$DOTFILES/packages/agent-plugins"
SKILL_LOCK="$HOME/.agents/.skill-lock.json"

# ── Small helpers ──────────────────────────────────────────────────────────
info() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err()  { printf 'ERROR: %s\n' "$*" >&2; }
fail() { FAILURES+=("$*"); }

have() { command -v "$1" >/dev/null 2>&1; }

# BEGIN version_ge
# Compare dotted numeric versions. Exit 0 when $1 >= $2.
version_ge() {
  local i x y
  local -a a=() b=()
  IFS=. read -r -a a <<< "${1%%-*}"
  IFS=. read -r -a b <<< "${2%%-*}"
  for ((i = 0; i < ${#a[@]} || i < ${#b[@]}; i++)); do
    x="${a[i]:-0}"
    y="${b[i]:-0}"
    ((10#$x > 10#$y)) && return 0
    ((10#$x < 10#$y)) && return 1
  done
  return 0
}
# END version_ge

# Ensure ~/.npmrc carries the npm release cooldown. The file also holds a
# private auth token and machine-specific prefix, so it is never tracked and
# this function never prints or rewrites its existing lines.
ensure_npm_cooldown() {
  local npmrc="$HOME/.npmrc"
  if [[ ! -f "$npmrc" ]]; then
    (umask 077 && printf 'min-release-age=7\n' > "$npmrc") || return 1
    return 0
  fi
  if grep -qE '^[[:space:]]*min-release-age[[:space:]]*=' "$npmrc"; then
    return 0
  fi
  # Keep the setting on its own line even if the file lacks a trailing newline.
  if [[ -s "$npmrc" ]] && [[ "$(tail -c 1 "$npmrc")" != "" ]]; then
    printf '\n' >> "$npmrc" || return 1
  fi
  printf 'min-release-age=7\n' >> "$npmrc" || return 1
}

# mise owns the OpenCode binary, so OpenCode must not replace it itself.
# Merge "autoupdate": false into the (untracked, machine-local) config.
ensure_opencode_no_autoupdate() {
  local cfg="$HOME/.config/opencode/opencode.json" tmp
  mkdir -p "$(dirname "$cfg")" || return 1
  # shellcheck disable=SC2016 # literal $schema key
  [[ -f "$cfg" ]] || printf '{"$schema": "https://opencode.ai/config.json"}\n' > "$cfg" || return 1
  [[ "$(jq -r '.autoupdate' "$cfg" 2>/dev/null)" == "false" ]] && return 0
  tmp="$(mktemp "$cfg.XXXXXX")" || return 1
  if jq '.autoupdate = false' "$cfg" > "$tmp"; then mv -f "$tmp" "$cfg"; else rm -f "$tmp"; return 1; fi
}

mise_bin() {
  if have mise; then
    command -v mise
  elif [[ -x "$HOME/.local/bin/mise" ]]; then
    printf '%s\n' "$HOME/.local/bin/mise"
  else
    return 1
  fi
}

# Codex's standalone installer links ~/.local/bin/codex, which non-login
# shells may not have on PATH; the macOS app bundles its own copy.
codex_bin() {
  if have codex; then
    command -v codex
  elif [[ -x "$HOME/.local/bin/codex" ]]; then
    printf '%s\n' "$HOME/.local/bin/codex"
  elif [[ -x /Applications/Codex.app/Contents/Resources/codex ]]; then
    printf '%s\n' /Applications/Codex.app/Contents/Resources/codex
  else
    return 1
  fi
}

# Move a real file/dir out of the way, preserving its path relative to $HOME.
backup_path() {
  local rel="$1" src="$HOME/$1" dst="$BACKUP_DIR/$1"
  [[ -e "$src" || -L "$src" ]] || return 0
  mkdir -p "$(dirname "$dst")"
  mv "$src" "$dst"
  BACKUP_USED=1
  info "  backed up ~/$rel → $dst"
}

# Emit the relative target paths from stow "simulate" conflict output.
stow_conflict_targets() {
  local out="$1"
  printf '%s\n' "$out" | sed -n \
    -e 's/^.*existing target is neither a link nor a directory: //p' \
    -e 's/^.*existing target is not owned by stow: //p' \
    -e 's/^.*cannot stow .* over existing target \(.*\) since .*/\1/p' \
    -e 's/^.*CONFLICT[^:]*: *//p' \
  | sed -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^WARNING/d' -e '/^All operations/d'
}

# Dangling symlinks whose target path mentions a dotfiles checkout.
find_legacy_links() {
  local d
  for d in "$HOME" "$HOME/.config" "$HOME/.claude" "$HOME/Applications"; do
    [[ -d "$d" ]] || continue
    local maxdepth=1
    case "$d" in
      "$HOME") maxdepth=1 ;;
      "$HOME/.config"|"$HOME/.claude") maxdepth=4 ;;
      "$HOME/Applications") maxdepth=3 ;;
    esac
    find "$d" -maxdepth "$maxdepth" -type l 2>/dev/null || true
  done | while IFS= read -r link; do
    [[ -e "$link" ]] && continue
    local target
    target="$(readlink "$link" 2>/dev/null || true)"
    [[ "$target" == *dotfiles* ]] && printf '%s\n' "$link"
  done
}

# ── install ────────────────────────────────────────────────────────────────
cmd_install() {
  if (($#)); then
    case "$1" in
      -h|--help)
        info "usage: dots install"
        info "  Bootstrap/refresh this machine (stow, packages, mise, git, T3)."
        return 0
        ;;
      *)
        err "dots install does not accept: $1"
        info "usage: dots install"
        return 1
        ;;
    esac
  fi
  info "=== dots install (${OS}) ==="

  # 1. ~/.env
  if [[ ! -f "$HOME/.env" ]]; then
    err "$HOME/.env not found."
    info ""
    info "  cp \"$DOTFILES/.env.example\" $HOME/.env"
    info "  \$EDITOR $HOME/.env   # fill in real values"
    info ""
    exit 1
  fi
  chmod 600 "$HOME/.env"
  # shellcheck disable=SC1091
  source "$HOME/.env"
  : "${GIT_USER_NAME:=}"
  : "${GIT_USER_EMAIL:=}"

  # 2. OS packages
  info "→ Installing OS packages..."
  if [[ "$OS" == darwin ]]; then
    if ! xcode-select -p >/dev/null 2>&1; then
      info "  Installing Xcode Command Line Tools..."
      xcode-select --install || true
      info "  Press Enter after the installer completes."
      read -r || true
    fi
    if ! have brew; then
      info "  Installing Homebrew..."
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
    brew bundle --file="$DOTFILES/packages/Brewfile" || fail "brew bundle"
  else
    local apt_file="" pkgs=()
    if [[ -f "$DOTFILES/packages/apt.txt" ]]; then
      apt_file="$DOTFILES/packages/apt.txt"
    elif [[ -f "$DOTFILES/packages/apt-packages.txt" ]]; then
      apt_file="$DOTFILES/packages/apt-packages.txt"
    fi
    if [[ -n "$apt_file" ]]; then
      while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | xargs)"
        [[ -n "$line" ]] && pkgs+=("$line")
      done < "$apt_file"
      if ((${#pkgs[@]})); then
        if sudo -n true 2>/dev/null; then
          sudo apt-get update || fail "apt-get update"
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}" || fail "apt-get install"
        else
          warn "sudo requires a password; run this yourself:"
          info "  sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y ${pkgs[*]}"
          MANUAL+=("Install apt packages (sudo apt-get install -y ${pkgs[*]})")
        fi
      fi
    else
      warn "packages/apt.txt not found — skipping apt packages"
    fi
  fi

  # 3. mise
  if ! mise_bin >/dev/null; then
    info "→ Installing mise..."
    curl https://mise.run | sh || fail "install mise"
  fi
  local MISE
  MISE="$(mise_bin || true)"

  # 4. Legacy cleanup (before stowing)
  info "→ Removing stale dotfiles symlinks..."
  local removed=0 link
  while IFS= read -r link; do
    rm -f "$link"
    info "  removed $link"
    removed=$((removed + 1))
  done < <(find_legacy_links)
  if ((removed == 0)); then info "  none found"; fi

  if [[ "$OS" == darwin ]]; then
    for label in com.dotfiles.autosync com.dotfiles.diffcheck; do
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      rm -f "$HOME/Library/LaunchAgents/$label.plist"
    done
    if [[ -L "$HOME/Applications/Arc.app" ]]; then
      local arc_target
      arc_target="$(readlink "$HOME/Applications/Arc.app")"
      if [[ "$arc_target" == *dotfiles* ]]; then
        rm -f "$HOME/Applications/Arc.app"
        info "  removed legacy ~/Applications/Arc.app symlink"
      fi
    fi
  fi

  # 5. Stow
  info "→ Stowing packages..."
  local pkg group root simulate rel
  for group in "${STOW_GROUPS[@]}"; do
    root="$DOTFILES/stow/$group"
    [[ -d "$root" ]] || continue
    for pkg in "$root"/*/; do
      [[ -d "$pkg" ]] || continue
      pkg="$(basename "$pkg")"
      simulate="$(stow --no-folding -d "$root" -t "$HOME" --simulate "$pkg" 2>&1 || true)"
      while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        # Real files/dirs are backed up. A symlink into another dotfiles
        # checkout (old layout or a different clone) is replaced.
        if [[ -L "$HOME/$rel" ]]; then
          if [[ "$(readlink "$HOME/$rel")" == *dotfiles* ]]; then
            rm -f "$HOME/$rel"
            info "  removed foreign dotfiles link ~/$rel"
          fi
        elif [[ -f "$HOME/$rel" || -d "$HOME/$rel" ]]; then
          backup_path "$rel"
        fi
      done < <(stow_conflict_targets "$simulate")
      if ! stow --no-folding -d "$root" -t "$HOME" --restow "$pkg" 2>&1 | sed 's/^/  /'; then
        fail "stow $group/$pkg"
      fi
    done
  done

  # 5a. dots on PATH (the sync timer/agent started below runs ~/.local/bin/dots)
  info "→ Linking dots into ~/.local/bin"
  mkdir -p "$HOME/.local/bin"
  if [[ -L "$HOME/.local/bin/dot" ]]; then
    local old_dot
    old_dot="$(readlink "$HOME/.local/bin/dot" 2>/dev/null || true)"
    if [[ "$old_dot" == *dotfiles* ]]; then
      rm -f "$HOME/.local/bin/dot"
      info "  removed legacy ~/.local/bin/dot"
    fi
  fi
  ln -sfn "$DOTFILES/bin/dots" "$HOME/.local/bin/dots"
  ln -sfn "$DOTFILES/bin/claude-ctx" "$HOME/.local/bin/claude-ctx"

  # 5b. Secrets (Infisical → ~/.config/dot/secrets.{zsh,env})
  # The CLI used to be called dot; drop its units/agent before installing dots.
  if [[ "$OS" == linux ]]; then
    if systemctl --user show-environment >/dev/null 2>&1; then
      systemctl --user disable --now dot-secret-sync.timer >/dev/null 2>&1 || true
      rm -f "$HOME/.config/systemd/user/dot-secret-sync.timer" \
            "$HOME/.config/systemd/user/dot-secret-sync.service"
      systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
  else
    launchctl bootout "gui/$(id -u)/com.dot.secret-sync" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.dot.secret-sync.plist"
  fi

  if [[ -f "$HOME/.config/dot/infisical.env" ]]; then
    info "→ dots secret sync"
    if ! "$DOTFILES/bin/dots-secret" sync 2>&1 | sed 's/^/  /'; then
      fail "dots secret sync"
    fi
    if [[ "$OS" == linux ]]; then
      if systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user daemon-reload || fail "systemctl --user daemon-reload"
        systemctl --user enable --now dots-secret-sync.timer \
          || fail "enable dots-secret-sync.timer"
      else
        warn "systemd --user not available — skipping dots-secret-sync.timer"
      fi
    else
      launchctl bootout "gui/$(id -u)/com.dots.secret-sync" 2>/dev/null || true
      launchctl bootstrap "gui/$(id -u)" \
        "$HOME/Library/LaunchAgents/com.dots.secret-sync.plist" \
        || fail "launchctl bootstrap com.dots.secret-sync"
    fi
  else
    MANUAL+=("Infisical identity missing: create ~/.config/dot/infisical.env (see README › Secrets)")
  fi

  # 6. Supply-chain cooldown (npm)
  info "→ Ensuring npm release cooldown (~/.npmrc)..."
  if ensure_npm_cooldown; then
    info "  min-release-age=7 present in ~/.npmrc"
  else
    fail "npm cooldown (~/.npmrc)"
  fi
  if ensure_opencode_no_autoupdate; then
    info "  OpenCode autoupdate off (mise upgrades it)"
  else
    fail "OpenCode autoupdate (~/.config/opencode/opencode.json)"
  fi

  # 7. Git identity
  info "→ Configuring git identity..."
  local identity="$HOME/.config/git/identity"
  if [[ -f "$identity" ]]; then
    info "  ~/.config/git/identity already exists — leaving it alone"
  elif [[ -z "$GIT_USER_NAME" ]]; then
    err "GIT_USER_NAME is empty in ~/.env — skipping git identity"
    MANUAL+=("Set GIT_USER_NAME/GIT_USER_EMAIL in ~/.env and re-run dots install")
  elif [[ "$GIT_USER_NAME" == *"@"* || "$GIT_USER_NAME" == "user.email" ]]; then
    err "GIT_USER_NAME looks wrong (\"$GIT_USER_NAME\") — must be a full name, not an email — skipping git identity"
    MANUAL+=("Fix GIT_USER_NAME in ~/.env (full name, e.g. \"Ada Lovelace\")")
  elif [[ -z "$GIT_USER_EMAIL" ]]; then
    err "GIT_USER_EMAIL is empty in ~/.env — skipping git identity"
    MANUAL+=("Set GIT_USER_EMAIL in ~/.env and re-run dots install")
  else
    mkdir -p "$(dirname "$identity")"
    {
      printf '[user]\n'
      printf '\tname = %s\n' "$GIT_USER_NAME"
      printf '\temail = %s\n' "$GIT_USER_EMAIL"
    } > "$identity"
    chmod 600 "$identity"
    info "  wrote ~/.config/git/identity"
  fi

  # Identity must be global only. A repo-local user.name/user.email caused
  # 185 commits with the wrong author, so remove any local override.
  local local_git_name local_git_email
  local_git_name="$(git -C "$DOTFILES" config --local user.name 2>/dev/null || true)"
  if [[ -n "$local_git_name" ]]; then
    git -C "$DOTFILES" config --local --unset-all user.name || true
    info "  removed repo-local user.name (\"$local_git_name\")"
  fi
  local_git_email="$(git -C "$DOTFILES" config --local user.email 2>/dev/null || true)"
  if [[ -n "$local_git_email" ]]; then
    git -C "$DOTFILES" config --local --unset-all user.email || true
    info "  removed repo-local user.email (\"$local_git_email\")"
  fi

  if [[ -f "$HOME/.gitconfig" && ! -L "$HOME/.gitconfig" ]]; then
    backup_path ".gitconfig"
    local extra=""
    extra="$(grep -E '^\[' "$BACKUP_DIR/.gitconfig" 2>/dev/null | grep -vE '^\[(user|credential)' || true)"
    info "  git now reads ~/.config/git/config"
    if [[ -n "$extra" ]]; then
      info "  note: the old ~/.gitconfig had extra sections: $(printf '%s ' "$extra")"
    fi
  fi

  # 8. mise install (non-fatal)
  if [[ -n "$MISE" ]]; then
    info "→ mise install..."
    if "$MISE" install --yes 2>&1 | sed 's/^/  /'; then
      # Later steps (npx, OpenCode plugin add, dots-agents) need mise's tools,
      # but a fresh install has not put its shims on this shell's PATH yet.
      if [[ -d "$HOME/.local/share/mise/shims" ]]; then
        PATH="$HOME/.local/share/mise/shims:$PATH"
        export PATH
        hash -r
      fi
    else
      fail "mise install"
    fi
  else
    fail "mise not available"
  fi

  # 8a. Agent skills and plugins (non-fatal)
  info "→ Agent skills and plugins..."
  cmd_skills sync || fail "dots skills sync"

  # 8b. Agent MCP servers (global; project sync runs inside a repo)
  info "→ Agent MCP servers..."
  "$DOTFILES/bin/dots-agents" sync --global-only || fail "dots agents sync"

  # 8c. tmux plugins (.tmux.conf runs TPM; resurrect/continuum need it)
  if have tmux && [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    info "→ tmux plugin manager (TPM)..."
    if git clone -q --depth 1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"; then
      "$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null 2>&1 || fail "tmux plugins install"
    else
      fail "TPM clone"
    fi
  fi

  # 9. bat cache + git hooks
  if have bat; then
    info "→ bat cache --build"
    bat cache --build >/dev/null 2>&1 || fail "bat cache --build"
  fi
  info "→ git core.hooksPath"
  git -C "$DOTFILES" config core.hooksPath "$DOTFILES/hooks" || fail "git hooksPath"

  # 10. OS-specific post-install
  if [[ "$OS" == darwin ]]; then
    info "→ macOS defaults..."
    bash "$DOTFILES/scripts/macos-defaults.sh" || fail "macOS defaults"
    if [[ -d "$HOME/Library/Application Support/zen" ]]; then
      info "→ Linking Zen profile..."
      bash "$DOTFILES/zen/link-profile.sh" || fail "zen link-profile"
    fi
    open -a AeroSpace 2>/dev/null || true
    brew services start sketchybar 2>/dev/null || true
    brew services start borders 2>/dev/null || true
    mkdir -p "$HOME/Desktop/Screenshots"
  else
    if systemctl --user show-environment >/dev/null 2>&1; then
      info "→ systemctl --user daemon-reload"
      systemctl --user daemon-reload || fail "systemctl --user daemon-reload"
    fi
  fi

  # 11. Login shell
  local zsh_path
  zsh_path="$(command -v zsh || true)"
  if [[ -z "$zsh_path" ]]; then
    warn "zsh not installed — cannot set login shell"
    MANUAL+=("Install zsh, then: chsh -s \$(command -v zsh)")
  elif [[ "${SHELL:-}" != *zsh ]]; then
    info "→ Setting login shell to zsh..."
    if [[ "$OS" == darwin ]]; then
      if chsh -s "$zsh_path" 2>/dev/null; then
        info "  login shell updated"
      else
        info "  Run manually: chsh -s $zsh_path"
        MANUAL+=("chsh -s $zsh_path")
      fi
    else
      if sudo -n chsh -s "$zsh_path" "$USER" 2>/dev/null; then
        info "  login shell updated"
      else
        info "  Run manually: sudo chsh -s $zsh_path $USER"
        MANUAL+=("sudo chsh -s $zsh_path $USER")
      fi
    fi
  fi

  # 12. Directories, T3 sync
  mkdir -p "$HOME/.zsh/cache"
  if [[ -d "${T3CODE_HOME:-$HOME/.t3}/userdata" ]]; then
    info "→ dots t3 push"
    cmd_t3 push || fail "dots t3 push"
  fi

  # 13. GitHub auth (never prompt)
  if ! gh auth status >/dev/null 2>&1; then
    MANUAL+=("Authenticate GitHub: gh auth login")
  fi

  # 14. Summary
  info ""
  info "=== dots install complete ==="
  if ((${#FAILURES[@]})); then
    info ""
    info "Failures:"
    for f in "${FAILURES[@]}"; do info "  - $f"; done
  fi
  if ((BACKUP_USED)); then
    info ""
    info "Conflicting files backed up to: $BACKUP_DIR"
  fi
  if [[ "$OS" == darwin ]]; then
    MANUAL+=("Grant Accessibility permission to AeroSpace")
    MANUAL+=("Log out and back in for macOS defaults to take effect")
  fi
  MANUAL+=("Sign in to T3 Code")
  MANUAL+=("Log in to agent CLIs you use (claude, codex, opencode)")
  if ((${#MANUAL[@]})); then
    info ""
    info "Manual steps remaining:"
    for m in "${MANUAL[@]}"; do info "  - $m"; done
  fi
  if ((${#FAILURES[@]})); then
    return 1
  fi
  return 0
}

# ── doctor helpers ─────────────────────────────────────────────────────────
# Join at most $1 words with ", " and summarize the rest as "(+N more)".
doctor_join_words() { # max word...
  local max="$1" out="" n=0 w
  shift
  for w in "$@"; do
    if ((n < max)); then
      out="${out:+$out, }$w"
    fi
    n=$((n + 1))
  done
  if ((n > max)); then
    out="$out (+$((n - max)) more)"
  fi
  printf '%s\n' "$out"
}

# True when a TOML file has the exact table header (trailing spaces ignored).
doctor_toml_table() { # file header
  [[ -f "$1" ]] || return 1
  awk -v target="$2" '
    { line = $0; sub(/[[:space:]]+$/, "", line) }
    line == target { found = 1; exit }
    END { exit found ? 0 : 1 }
  ' "$1"
}

# Codex trusts a project when ~/.codex/config.toml has its path with
# trust_level = "trusted". This mirrors agents_codex_project_trusted in
# bin/dots-agents for one path, so doctor does not source that whole CLI.
doctor_codex_trusted() { # path
  local cfg="$HOME/.codex/config.toml"
  [[ -f "$cfg" ]] || return 1
  awk -v target="[projects.\"$1\"]" '
    /^\[/ {
      if (found) exit
      if ($0 == target) { found = 1 }
      next
    }
    found && /^[[:space:]]*trust_level[[:space:]]*=[[:space:]]*"trusted"/ { ok = 1; exit }
    END { exit ok ? 0 : 1 }
  ' "$cfg"
}

# A Codex plugin counts as installed when its config table exists or its cache
# directory is present (the same signals `codex plugin list` reports).
doctor_codex_plugin() { # plugin-id (name@marketplace)
  local id="$1" name market
  doctor_toml_table "$HOME/.codex/config.toml" "[plugins.\"$id\"]" && return 0
  name="${id%@*}"
  market="${id#*@}"
  if [[ "$market" == "$id" ]]; then
    market=""
  fi
  [[ -d "$HOME/.codex/plugins/cache/$market/$name" ]] && return 0
  [[ -d "$HOME/.codex/plugins/$id" ]] && return 0
  return 1
}

# ── doctor ─────────────────────────────────────────────────────────────────
cmd_doctor() {
  local local_only=0
  while (($#)); do
    case "$1" in
      --local) local_only=1 ;;
      -h|--help)
        info "usage: dots doctor [--local]"
        info "  Health check (may contact Infisical and refresh token caches)."
        info "  --local skips every check that contacts a network service."
        return 0
        ;;
      *)
        err "dots doctor does not accept: $1"
        info "usage: dots doctor [--local]"
        return 1
        ;;
    esac
    shift
  done
  local problems=0 warnings=0
  ok()   { printf '  ✓ %s\n' "$*"; }
  bad()  { printf '  ✗ %s\n' "$*"; problems=$((problems + 1)); }
  note() { printf '  ! %s\n' "$*"; warnings=$((warnings + 1)); }

  info "=== dots doctor (${OS}) ==="

  # Symlinks for every stowed file
  info "→ Stowed file symlinks"
  local group root pkg file rel dest real
  for group in "${STOW_GROUPS[@]}"; do
    root="$DOTFILES/stow/$group"
    [[ -d "$root" ]] || continue
    for pkg in "$root"/*/; do
      [[ -d "$pkg" ]] || continue
      pkg="$(basename "$pkg")"
      while IFS= read -r -d '' file; do
        [[ -f "$file" && ! -L "$file" ]] || continue
        rel="${file#"$root/$pkg/"}"
        dest="$HOME/$rel"
        if [[ -L "$dest" ]]; then
          real="$(readlink -f "$dest" 2>/dev/null || true)"
          if [[ "$real" == "$(readlink -f "$file")" ]]; then
            ok "$rel"
          else
            bad "$rel → ${real:-<broken>} (expected $file)"
          fi
        elif [[ -e "$dest" ]]; then
          bad "$rel is a real file (expected symlink to $file)"
        else
          bad "$rel missing (expected symlink to $file)"
        fi
      done < <(find "$root/$pkg" -type f -print0 | sort -z)
    done
  done

  # Dangling symlinks into a dotfiles checkout
  info "→ Dangling dotfiles symlinks"
  local link any=0
  while IFS= read -r link; do
    bad "dangling: $link → $(readlink "$link")"
    any=1
  done < <(find_legacy_links)
  ((any == 0)) && ok "none"

  # Commands
  info "→ Commands"
  local c
  for c in zsh stow mise git gh starship atuin fzf rg eza bat zoxide delta; do
    if [[ "$c" == mise ]]; then
      if mise_bin >/dev/null; then ok "mise"; else bad "mise not installed"; fi
    elif have "$c"; then
      ok "$c"
    else
      bad "$c not found"
    fi
  done
  # Agent CLIs are installed by their own installers, not this repo, so a
  # missing binary is a warning rather than a failure.
  for c in claude codex opencode; do
    if have "$c"; then
      ok "$c"
    else
      note "$c not found (install it with its own installer)"
    fi
  done

  # Agent skills: every manifest name must exist under ~/.agents/skills and be
  # reachable from ~/.claude/skills (a directory or a symlink that resolves).
  info "→ Agent skills"
  local skill_total=0 skill
  local -a skill_missing=() skill_unlinked=()
  if [[ ! -f "$AGENT_SKILLS_MANIFEST" ]]; then
    note "packages/agent-skills not found — skill checks skipped"
  else
    while IFS= read -r skill; do
      [[ -n "$skill" ]] || continue
      skill_total=$((skill_total + 1))
      if [[ ! -d "$HOME/.agents/skills/$skill" ]]; then
        skill_missing+=("$skill")
      elif [[ ! -d "$HOME/.claude/skills/$skill" ]]; then
        skill_unlinked+=("$skill")
      fi
    done < <(manifest_skill_names)
    if ((skill_total == 0)); then
      note "packages/agent-skills lists no skills"
    else
      if ((${#skill_missing[@]})); then
        bad "not installed in ~/.agents/skills: $(doctor_join_words 10 "${skill_missing[@]}") (run: dots skills sync)"
      fi
      if ((${#skill_unlinked[@]})); then
        bad "not linked into ~/.claude/skills: $(doctor_join_words 10 "${skill_unlinked[@]}") (run: dots skills sync)"
      fi
      if ((${#skill_missing[@]} == 0 && ${#skill_unlinked[@]} == 0)); then
        ok "$skill_total skills present and linked"
      fi
    fi
  fi

  # Agent plugins: Codex config table or cache dir, OpenCode plugin array, and
  # the Claude plugins enabled in the tracked settings.
  info "→ Agent plugins"
  local p_entry p_agent p_rest p_id p_source oc_cfg
  oc_cfg="$HOME/.config/opencode/opencode.json"
  if [[ ! -f "$AGENT_PLUGINS_MANIFEST" ]]; then
    note "packages/agent-plugins not found — plugin checks skipped"
  else
    while IFS= read -r p_entry; do
      p_agent="${p_entry%% *}"
      p_rest="${p_entry#* }"
      if [[ "$p_rest" == "$p_entry" ]]; then
        note "malformed plugin entry: $p_entry"
        continue
      fi
      p_id="${p_rest%% *}"
      p_source="${p_rest#* }"
      if [[ "$p_source" == "$p_rest" ]]; then
        p_source=""
      fi
      case "$p_agent" in
        codex)
          if ! codex_bin >/dev/null 2>&1; then
            note "codex not found — Codex plugin $p_id unchecked"
          elif doctor_codex_plugin "$p_id"; then
            ok "codex: $p_id"
          else
            bad "codex: $p_id not installed (run: dots skills sync)"
          fi
          ;;
        opencode)
          if ! have jq; then
            note "jq not found — OpenCode plugin $p_id unchecked"
          elif [[ ! -f "$oc_cfg" ]]; then
            note "$HOME/.config/opencode/opencode.json not found — OpenCode plugin $p_id unchecked"
          # OpenCode 2.x writes .plugins; older configs use .plugin. Check both.
          elif jq -e --arg s "$p_source" \
              '(((.plugin // []) + (.plugins // [])) | index($s)) != null' \
              "$oc_cfg" >/dev/null 2>&1; then
            ok "opencode: $p_id"
          else
            bad "opencode: $p_id missing from $oc_cfg (run: dots skills sync)"
          fi
          ;;
        *)
          note "unknown plugin agent in manifest: $p_agent"
          ;;
      esac
    done < <(manifest_rows "$AGENT_PLUGINS_MANIFEST")
  fi

  # Claude Code plugins: every enabled one must be in installed_plugins.json.
  local claude_settings claude_installed p_enabled p_name
  local -a claude_missing=()
  claude_settings="$DOTFILES/stow/common/claude/.claude/settings.json"
  claude_installed="$HOME/.claude/plugins/installed_plugins.json"
  if ! have jq; then
    note "jq not found — Claude plugins unchecked"
  elif [[ ! -f "$claude_settings" ]]; then
    note "stow/common/claude/.claude/settings.json not found — Claude plugins unchecked"
  elif [[ ! -f "$claude_installed" ]]; then
    note "$HOME/.claude/plugins/installed_plugins.json not found — Claude plugins unchecked"
  else
    if ! p_enabled="$(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' \
        "$claude_settings" 2>/dev/null)"; then
      note "cannot read $claude_settings — Claude plugins unchecked"
      p_enabled=""
    fi
    while IFS= read -r p_name; do
      [[ -n "$p_name" ]] || continue
      if jq -e --arg p "$p_name" '(.plugins // {}) | has($p)' \
          "$claude_installed" >/dev/null 2>&1; then
        ok "claude: $p_name"
      else
        claude_missing+=("$p_name")
      fi
    done <<< "$p_enabled"
    if ((${#claude_missing[@]})); then
      bad "claude: not installed: $(doctor_join_words 10 "${claude_missing[@]}") (run: dots skills sync)"
    fi
  fi

  # MCP servers: config/agents/mcp.json is the source, so each name must reach
  # all three clients. Never run `claude mcp list` here: it contacts servers.
  info "→ MCP servers"
  local mcp_file mcp_names mcp_name mcp_missing mcp_checked
  local claude_cfg_ok=1 codex_cfg_ok=1 oc_cfg_ok=1
  mcp_file="$DOTFILES/config/agents/mcp.json"
  if ! have jq; then
    note "jq not found — MCP checks skipped"
  elif [[ ! -f "$mcp_file" ]]; then
    note "config/agents/mcp.json not found — MCP checks skipped"
  else
    if ! mcp_names="$(jq -r '.mcpServers // {} | keys[]' "$mcp_file" 2>/dev/null)"; then
      note "cannot read $mcp_file — MCP checks skipped"
    elif [[ -z "$mcp_names" ]]; then
      note "config/agents/mcp.json lists no servers"
    else
      if [[ ! -f "$HOME/.claude.json" ]]; then
        note "$HOME/.claude.json not found — Claude MCP servers unchecked"
        claude_cfg_ok=0
      fi
      if [[ ! -f "$HOME/.codex/config.toml" ]]; then
        note "$HOME/.codex/config.toml not found — Codex MCP servers unchecked"
        codex_cfg_ok=0
      fi
      if [[ ! -f "$oc_cfg" ]]; then
        note "$HOME/.config/opencode/opencode.json not found — OpenCode MCP servers unchecked"
        oc_cfg_ok=0
      fi
      while IFS= read -r mcp_name; do
        [[ -n "$mcp_name" ]] || continue
        mcp_missing=""
        mcp_checked=""
        if ((claude_cfg_ok)); then
          mcp_checked="${mcp_checked:+$mcp_checked, }Claude"
          jq -e --arg n "$mcp_name" '(.mcpServers // {}) | has($n)' \
            "$HOME/.claude.json" >/dev/null 2>&1 || mcp_missing="${mcp_missing:+$mcp_missing, }Claude"
        fi
        if ((codex_cfg_ok)); then
          mcp_checked="${mcp_checked:+$mcp_checked, }Codex"
          doctor_toml_table "$HOME/.codex/config.toml" "[mcp_servers.$mcp_name]" \
            || mcp_missing="${mcp_missing:+$mcp_missing, }Codex"
        fi
        if ((oc_cfg_ok)); then
          mcp_checked="${mcp_checked:+$mcp_checked, }OpenCode"
          jq -e --arg n "$mcp_name" '(.mcp // {}) | has($n)' \
            "$oc_cfg" >/dev/null 2>&1 || mcp_missing="${mcp_missing:+$mcp_missing, }OpenCode"
        fi
        if [[ -z "$mcp_checked" ]]; then
          note "$mcp_name: no client config found"
        elif [[ -z "$mcp_missing" ]]; then
          ok "$mcp_name ($mcp_checked)"
        else
          bad "$mcp_name missing from: $mcp_missing"
        fi
      done <<< "$mcp_names"
    fi
  fi

  # Trust for the current directory: Codex ignores project config until its
  # path is trusted, and mise ignores untrusted config files.
  info "→ Trust"
  local repo_top git_common main_root mise_cfg MISE_TRUST trust_dir
  repo_top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$repo_top" ]]; then
    note "not inside a git repo — skipped"
  else
    git_common="$(git -C "$repo_top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [[ -z "$git_common" ]]; then
      git_common="$(git -C "$repo_top" rev-parse --git-common-dir 2>/dev/null || true)"
      case "$git_common" in
        ""|/*) ;;
        *) git_common="$repo_top/$git_common" ;;
      esac
    fi
    if [[ -z "$git_common" ]]; then
      main_root="$repo_top"
    else
      main_root="$(dirname "$git_common")"
    fi
    if [[ ! -f "$HOME/.codex/config.toml" ]]; then
      note "$HOME/.codex/config.toml not found — Codex trust unchecked"
    elif trust_dir="$main_root"; while [[ "$trust_dir" != / ]] && ! doctor_codex_trusted "$trust_dir"; do trust_dir="$(dirname "$trust_dir")"; done; [[ "$trust_dir" != / ]]; then
      # Codex trust on a parent folder covers the repo too.
      ok "codex trusts $main_root (via $trust_dir)"
    else
      bad "codex does not trust $main_root (run: dots agents sync)"
    fi

    mise_cfg=""
    if [[ -f "$repo_top/mise.toml" ]]; then
      mise_cfg="$repo_top/mise.toml"
    elif [[ -f "$repo_top/.mise.toml" ]]; then
      mise_cfg="$repo_top/.mise.toml"
    fi
    if [[ -z "$mise_cfg" ]]; then
      ok "no mise config in this repo"
    elif ! MISE_TRUST="$(mise_bin)"; then
      note "mise not installed — mise trust unchecked"
    elif (cd "$repo_top" && "$MISE_TRUST" trust --show 2>/dev/null) |
        grep -qxF -e "$repo_top: trusted" -e "~${repo_top#"$HOME"}: trusted"; then
      ok "mise trusts $mise_cfg"
    else
      bad "mise does not trust $mise_cfg (run: mise trust)"
    fi
  fi

  # tmux plugins: the tracked config runs TPM, so its clone must exist.
  info "→ tmux plugins"
  if ! have tmux; then
    note "tmux not installed — skipped"
  elif [[ -d "$HOME/.tmux/plugins/tpm" ]]; then
    ok "TPM installed"
  else
    bad "$HOME/.tmux/plugins/tpm missing (run: dots install)"
  fi

  # Login shell
  info "→ Login shell"
  local login_shell=""
  if [[ "$OS" == darwin ]]; then
    login_shell="$(dscl . -read "$HOME" UserShell 2>/dev/null | awk '{print $2}' || true)"
  else
    login_shell="$(getent passwd "$USER" 2>/dev/null | cut -d: -f7 || true)"
  fi
  if [[ "$login_shell" == *zsh ]]; then
    ok "$login_shell"
  else
    bad "login shell is ${login_shell:-unknown} (expected zsh)"
  fi

  # mise missing tools
  info "→ mise tools"
  local MISE missing
  MISE="$(mise_bin || true)"
  if [[ -z "$MISE" ]]; then
    bad "mise not installed"
  else
    missing="$("$MISE" ls --missing 2>/dev/null || true)"
    missing="$(printf '%s\n' "$missing" | sed '/^[[:space:]]*$/d' || true)"
    # Tools intentionally disabled (e.g. MISE_DISABLE_TOOLS in CI) are not
    # missing for our purposes.
    if [[ -n "${MISE_DISABLE_TOOLS:-}" ]]; then
      local -a disabled=()
      local disabled_tool
      IFS=',' read -r -a disabled <<< "$MISE_DISABLE_TOOLS"
      for disabled_tool in "${disabled[@]}"; do
        disabled_tool="${disabled_tool//[[:space:]]/}"
        [[ -n "$disabled_tool" ]] || continue
        missing="$(printf '%s\n' "$missing" \
          | grep -vE "^[[:space:]]*${disabled_tool}(@|[[:space:]]|$)" || true)"
      done
    fi
    if [[ -z "$missing" ]]; then
      ok "no missing tools"
    else
      while IFS= read -r line; do
        [[ -n "$line" ]] && bad "mise missing: $line"
      done <<< "$missing"
    fi
  fi

  # OS packages
  info "→ Packages"
  if [[ "$OS" == darwin ]]; then
    if have brew; then
      if brew bundle check --file "$DOTFILES/packages/Brewfile" >/dev/null 2>&1; then
        ok "brew bundle satisfied"
      else
        bad "brew bundle has missing packages (run: brew bundle --file $DOTFILES/packages/Brewfile)"
      fi
    else
      bad "brew not installed"
    fi
  else
    local apt_file=""
    [[ -f "$DOTFILES/packages/apt.txt" ]] && apt_file="$DOTFILES/packages/apt.txt"
    [[ -z "$apt_file" && -f "$DOTFILES/packages/apt-packages.txt" ]] && apt_file="$DOTFILES/packages/apt-packages.txt"
    if [[ -z "$apt_file" ]]; then
      note "packages/apt.txt not found"
    else
      local line
      while IFS= read -r line; do
        line="${line%%#*}"; line="$(printf '%s' "$line" | xargs)"
        [[ -z "$line" ]] && continue
        if dpkg -s "$line" >/dev/null 2>&1; then
          ok "$line"
        else
          bad "$line not installed"
        fi
      done < "$apt_file"
    fi
  fi

  # npm supply-chain cooldown
  info "→ npm cooldown"
  local npm_ver="" has_cooldown=0
  npm_ver="$(npm --version 2>/dev/null || true)"
  if [[ -f "$HOME/.npmrc" ]] && grep -qE '^[[:space:]]*min-release-age[[:space:]]*=' "$HOME/.npmrc"; then
    has_cooldown=1
  fi
  if [[ -z "$npm_ver" ]]; then
    note "npm not found — cannot confirm min-release-age support"
  elif ! version_ge "$npm_ver" 11.10.0; then
    note "npm $npm_ver ignores min-release-age (needs >= 11.10.0); cooldown inactive"
  elif ((has_cooldown)); then
    ok "$HOME/.npmrc has min-release-age (npm $npm_ver)"
  else
    bad "$HOME/.npmrc missing min-release-age (run: dots install)"
  fi

  # Git identity
  info "→ Git identity"
  if [[ -f "$HOME/.config/git/identity" ]]; then
    local uname_val
    uname_val="$(git config --global --includes user.name 2>/dev/null || true)"
    if [[ -z "$uname_val" ]]; then
      bad "git user.name is unset"
    elif [[ "$uname_val" == *"@"* ]]; then
      bad "git user.name looks like an email: $uname_val"
    else
      ok "user.name = $uname_val"
    fi
  else
    bad "$HOME/.config/git/identity missing"
  fi

  # T3 Code
  info "→ T3 Code"
  if [[ -d "${T3CODE_HOME:-$HOME/.t3}/userdata" ]]; then
    if cmd_t3 diff >/dev/null 2>&1; then
      ok "settings/keybindings in sync"
    else
      bad "T3 settings differ (run: dots t3 pull)"
    fi
  else
    ok "T3 Code not installed here"
  fi

  # Secrets (contacts Infisical, so --local skips it)
  info "→ Secrets"
  if ((local_only)); then
    note "skipped (--local)"
  elif [[ -f "$HOME/.config/dot/infisical.env" ]]; then
    if "$DOTFILES/bin/dots-secret" doctor >/dev/null 2>&1; then
      ok "dots secret doctor"
    else
      bad "dots secret doctor reported problems (run: dots secret doctor)"
    fi
  else
    note "Infisical identity missing (create ~/.config/dot/infisical.env)"
  fi

  # Repo cleanliness (warning only)
  info "→ Repo"
  if [[ -n "$(git -C "$DOTFILES" status --porcelain 2>/dev/null || true)" ]]; then
    note "working tree has uncommitted changes"
  else
    ok "clean working tree"
  fi

  info ""
  if ((problems > 0)); then
    info "$problems problem(s), $warnings warning(s)"
    return 1
  fi
  info "All checks passed ($warnings warning(s))"
  return 0
}

# ── t3 ─────────────────────────────────────────────────────────────────────
t3_userdata() { printf '%s\n' "${T3CODE_HOME:-$HOME/.t3}/userdata"; }

t3_require() {
  local ud
  ud="$(t3_userdata)"
  if [[ ! -d "$ud" ]]; then
    info "T3 Code not installed here"
    return 1
  fi
  return 0
}

filter_settings() {
  jq -S 'del(.projectSettingsOverrides, .projectAutoPullOverrides, .sourceControlHosts, .deviceHosts) | del(.providerInstances[]?.config?.serverPassword)'
}

cmd_t3() {
  local action="${1:-}"
  local ud repo="$DOTFILES/t3"
  ud="$(t3_userdata)"

  case "$action" in
    pull)
      if ! t3_require; then return 0; fi
      mkdir -p "$repo"
      cp "$ud/keybindings.json" "$repo/keybindings.json"
      filter_settings < "$ud/settings.json" > "$repo/settings.base.json"
      info "Pulled T3 Code settings into $repo"
      ;;
    push)
      if ! t3_require; then return 0; fi
      if [[ ! -f "$repo/keybindings.json" || ! -f "$repo/settings.base.json" ]]; then
        err "No tracked T3 settings in $repo (run: dots t3 pull on the other machine and commit)"
        return 1
      fi
      local ts
      ts="$(date +%Y%m%d-%H%M%S)"
      mkdir -p "$BACKUP_ROOT/$ts/t3"
      for f in keybindings.json settings.json; do
        [[ -f "$ud/$f" ]] && cp "$ud/$f" "$BACKUP_ROOT/$ts/t3/$f"
      done
      info "  backed up live T3 files to $BACKUP_ROOT/$ts/t3"
      cp "$repo/keybindings.json" "$ud/keybindings.json.tmp"
      mv "$ud/keybindings.json.tmp" "$ud/keybindings.json"
      if [[ -f "$ud/settings.json" ]]; then
        local tmp="$ud/settings.json.tmp.$$"
        jq -s '.[0] * .[1]' "$ud/settings.json" "$repo/settings.base.json" > "$tmp"
        mv "$tmp" "$ud/settings.json"
      else
        local tmp="$ud/settings.json.tmp.$$"
        cp "$repo/settings.base.json" "$tmp"
        mv "$tmp" "$ud/settings.json"
      fi
      info "Pushed T3 Code settings into $ud"
      ;;
    diff)
      if ! t3_require; then return 0; fi
      local rc=0
      if ! diff -u "$repo/keybindings.json" "$ud/keybindings.json"; then rc=1; fi
      if ! diff -u "$repo/settings.base.json" <(filter_settings < "$ud/settings.json"); then rc=1; fi
      [[ $rc -eq 0 ]] && info "T3 Code settings are in sync"
      return "$rc"
      ;;
    *)
      if [[ "$action" == "-h" || "$action" == "--help" ]]; then
        info "usage: dots t3 pull|push|diff"
        return 0
      fi
      err "usage: dots t3 pull|push|diff"
      return 1
      ;;
  esac
}

# ── upgrade ────────────────────────────────────────────────────────────────
# mise is locked (installs never rewrite mise.lock), so upgrades are explicit:
# bump the lock for both platforms, install here, commit, then run
# `dots install` on the other machine.
cmd_upgrade() {
  if (($# == 0)); then
    err "usage: dots upgrade <tool>...   (e.g. dots upgrade opencode)"
    return 1
  fi
  local mise
  mise="$(mise_bin)" || { err "mise not installed"; return 1; }
  "$mise" lock -g -p linux-x64,macos-arm64 --bump "$@" || return 1
  "$mise" install "$@" || return 1
  info "Upgraded: $*. Commit stow/common/mise/.config/mise/{config.toml,mise.lock},"
  info "push, then run 'dots install' on the other machine."
}

# ── skills ─────────────────────────────────────────────────────────────────
# Global third-party skills live in packages/agent-skills, global agent plugins
# in packages/agent-plugins. Both manifests track upstream; nothing is pinned.

# Print a manifest's data lines, trimmed, skipping blank and comment lines.
manifest_rows() {
  local file="$1" line
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    printf '%s\n' "$line"
  done < "$file"
}

# Emit every skill name in packages/agent-skills, one per line.
manifest_skill_names() {
  local line names name
  local -a names_arr=()
  while IFS= read -r line; do
    names="${line#* }"
    [[ "$names" == "$line" ]] && continue
    names_arr=()
    IFS=',' read -r -a names_arr <<< "$names"
    for name in "${names_arr[@]}"; do
      name="${name//[[:space:]]/}"
      [[ -n "$name" ]] && printf '%s\n' "$name"
    done
  done < <(manifest_rows "$AGENT_SKILLS_MANIFEST")
}

# Emit "<plugin-id> <source>" for one agent from packages/agent-plugins.
manifest_plugins_for() {
  local agent="$1" line entry id source
  while IFS= read -r line; do
    [[ "${line%% *}" == "$agent" ]] || continue
    entry="${line#* }"
    [[ "$entry" == "$line" ]] && continue
    id="${entry%% *}"
    source="${entry#* }"
    [[ "$source" == "$entry" ]] && source=""
    printf '%s %s\n' "$id" "$source"
  done < <(manifest_rows "$AGENT_PLUGINS_MANIFEST")
}

# Install manifest entries that are not present yet. Safe to rerun.
skills_sync() {
  local prune="$1"
  local source names line name
  local -a wanted=() missing=() extra_arr=()
  local name_file extras extra

  info "→ Skills (~/.agents/skills)"
  if ! have npx || ! have node; then
    warn "npx/node not found — skipping skills"
  elif [[ ! -f "$AGENT_SKILLS_MANIFEST" ]]; then
    warn "$AGENT_SKILLS_MANIFEST not found — skipping skills"
  else
    while IFS= read -r line; do
      source="${line%% *}"
      names="${line#* }"
      if [[ "$names" == "$line" ]]; then
        warn "manifest entry without skills: $line"
        continue
      fi
      wanted=()
      IFS=',' read -r -a wanted <<< "$names"
      missing=()
      for name in "${wanted[@]}"; do
        name="${name//[[:space:]]/}"
        [[ -n "$name" ]] || continue
        # Claude reads only ~/.claude/skills, so a skill without that link
        # is missing for Claude even when ~/.agents/skills has it.
        [[ -d "$HOME/.agents/skills/$name" && -d "$HOME/.claude/skills/$name" ]] ||
          missing+=("$name")
      done
      if ((${#missing[@]} == 0)); then
        info "  $source: up to date"
        continue
      fi
      info "  $source: installing ${#missing[@]} missing skill(s)"
      # < /dev/null keeps the installer from swallowing the manifest lines
      # that feed this loop.
      if npx -y skills@latest add "$source" -g -y -a claude-code codex opencode \
          -s "${missing[@]}" < /dev/null 2>&1 | sed 's/^/    /'; then
        wanted=()
        for name in "${missing[@]}"; do
          [[ -d "$HOME/.agents/skills/$name" && -d "$HOME/.claude/skills/$name" ]] ||
            wanted+=("$name")
        done
        if ((${#wanted[@]})); then
          warn "$source did not install or link: ${wanted[*]}"
          fail "skills missing from $source: ${wanted[*]}"
        else
          info "  installed: ${missing[*]}"
        fi
      else
        fail "skills add $source"
      fi
    done < <(manifest_rows "$AGENT_SKILLS_MANIFEST")

    # Report lock-file skills the manifest no longer lists. Hand-made folders
    # are absent from the lock file and are never touched.
    if [[ -f "$SKILL_LOCK" ]] && have jq; then
      name_file="$(mktemp)"
      manifest_skill_names | sort -u > "$name_file"
      extras="$(jq -r '.skills // {} | keys[]' "$SKILL_LOCK" 2>/dev/null \
        | while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            grep -qxF "$name" "$name_file" || printf '%s\n' "$name"
          done)"
      rm -f "$name_file"
      if [[ -z "$extras" ]]; then
        info "  no extra global skills"
      else
        extra_arr=()
        while IFS= read -r extra; do
          [[ -n "$extra" ]] && extra_arr+=("$extra")
        done <<< "$extras"
        info "  extra global skills not in the manifest:"
        printf '%s\n' "$extras" | sed 's/^/    /'
        if ((prune)); then
          info "  pruning extras..."
          if npx -y skills@latest remove -g -y "${extra_arr[@]}" \
               < /dev/null 2>&1 | sed 's/^/    /'; then
            info "  removed extras"
          else
            fail "skills remove extras"
          fi
        else
          info "  run 'dots skills sync --prune' to remove them"
        fi
      fi
    fi
  fi

  skills_sync_plugins
}

# Install whichever agent plugins from packages/agent-plugins are missing.
skills_sync_plugins() {
  local entry id source codex mkt

  info "→ Plugins"
  if [[ ! -f "$AGENT_PLUGINS_MANIFEST" ]]; then
    warn "$AGENT_PLUGINS_MANIFEST not found — skipping plugins"
    return 0
  fi

  if codex="$(codex_bin)"; then
    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue
      id="${entry%% *}"
      source="${entry#* }"
      if [[ "$source" == "$entry" || -z "$source" ]]; then
        warn "plugin entry without source: $entry"
        continue
      fi
      mkt="${id#*@}"
      if "$codex" plugin list < /dev/null 2>/dev/null \
          | awk -v id="$id" '$1 == id && $2 ~ /installed/ { found = 1 } END { exit !found }'; then
        info "  codex: $id installed"
        continue
      fi
      if ! "$codex" plugin marketplace list < /dev/null 2>/dev/null \
          | awk -v m="$mkt" '$1 == m { found = 1 } END { exit !found }'; then
        info "  codex: adding marketplace $mkt"
        if ! "$codex" plugin marketplace add "$source" < /dev/null 2>&1 | sed 's/^/    /'; then
          fail "codex marketplace add $mkt"
          continue
        fi
      fi
      info "  codex: installing $id"
      if "$codex" plugin add "$id" < /dev/null 2>&1 | sed 's/^/    /'; then
        info "  Codex: open an interactive session and run /hooks once to trust the pstack hook"
      else
        fail "codex plugin add $id"
      fi
    done < <(manifest_plugins_for codex)
  else
    warn "codex CLI not found — skipping Codex plugins"
  fi

  if have opencode; then
    while IFS= read -r entry; do
      [[ -n "$entry" ]] || continue
      id="${entry%% *}"
      source="${entry#* }"
      if [[ "$source" == "$entry" || -z "$source" ]]; then
        warn "plugin entry without source: $entry"
        continue
      fi
      # 2>&1: OpenCode prints the plugin table to stderr on some machines.
      # Run from the repo: the listing differs outside a git project.
      if (cd "$DOTFILES" && opencode plugin list < /dev/null 2>&1) \
          | awk -v id="$id" '$1 == id { found = 1 } END { exit !found }'; then
        info "  opencode: $id installed"
        continue
      fi
      info "  opencode: installing $id"
      if opencode plugin add "$source" < /dev/null 2>&1 | sed 's/^/    /'; then
        info "  opencode: restart the service to load $id"
      else
        fail "opencode plugin add $id"
      fi
    done < <(manifest_plugins_for opencode)
  else
    warn "opencode not found — skipping OpenCode plugins"
  fi
}

# Refresh every skill and plugin source to its newest release. Each step is
# independent, so one failing source does not stop the rest.
skills_upgrade() {
  local codex mkt p

  info "→ Skills"
  if have npx && have node; then
    if npx -y skills@latest update -g -y < /dev/null 2>&1 | sed 's/^/  /'; then
      info "  skills updated"
    else
      fail "skills update"
    fi
  else
    warn "npx/node not found — skipping skills update"
  fi

  info "→ Claude Code plugins"
  if have claude && have jq && [[ -f "$HOME/.claude/settings.json" ]]; then
    if claude plugin marketplace update < /dev/null 2>&1 | sed 's/^/  /'; then
      info "  marketplaces updated"
    else
      fail "claude plugin marketplace update"
    fi
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      info "  claude plugin update $p"
      if ! claude plugin update "$p" < /dev/null 2>&1 | sed 's/^/    /'; then
        fail "claude plugin update $p"
      fi
    done < <(jq -r '.enabledPlugins // {} | keys[]' "$HOME/.claude/settings.json" 2>/dev/null)
  else
    warn "claude, jq, or ~/.claude/settings.json missing — skipping Claude Code plugins"
  fi

  info "→ Codex plugins"
  if codex="$(codex_bin)"; then
    while IFS= read -r mkt; do
      [[ -n "$mkt" ]] || continue
      info "  codex marketplace upgrade $mkt"
      if ! "$codex" plugin marketplace upgrade "$mkt" < /dev/null 2>&1 | sed 's/^/    /'; then
        fail "codex marketplace upgrade $mkt"
      fi
    done < <(manifest_plugins_for codex | awk '{ sub(/^[^@]*@/, "", $1); print $1 }' | sort -u)
  else
    warn "codex CLI not found — skipping Codex plugins"
  fi

  info "→ OpenCode plugins"
  if have opencode; then
    if opencode plugin update < /dev/null 2>&1 | sed 's/^/  /'; then
      info "  plugins updated"
    else
      fail "opencode plugin update"
    fi
  else
    warn "opencode not found — skipping OpenCode plugins"
  fi
}

cmd_skills() {
  local action="sync" prune=0 failures_before i
  failures_before=${#FAILURES[@]}
  while (($#)); do
    case "$1" in
      sync|upgrade) action="$1" ;;
      --prune) prune=1 ;;
      -h|--help) info "usage: dots skills [sync|upgrade] [--prune]"; return 0 ;;
      *) err "usage: dots skills [sync|upgrade] [--prune]"; return 1 ;;
    esac
    shift
  done
  info "=== dots skills (${action}) ==="
  case "$action" in
    sync) skills_sync "$prune" ;;
    upgrade) skills_upgrade ;;
  esac
  # `fail` only records, so a standalone run must print the reasons here.
  if ((${#FAILURES[@]} > failures_before)); then
    warn "skills ${action} had $((${#FAILURES[@]} - failures_before)) failure(s):"
    for ((i = failures_before; i < ${#FAILURES[@]}; i++)); do
      info "  - ${FAILURES[i]}"
    done
    return 1
  fi
  return 0
}

# ── main ───────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
Usage: dots <command>

Commands:
  install   Bootstrap/refresh this machine (stow, packages, mise, git, T3)
  doctor    Health check (may contact Infisical); --local skips network checks
  t3 pull   Copy live T3 Code settings into the repo
  t3 push   Apply repo T3 Code settings to the live app
  t3 diff   Show differences between live and tracked T3 settings
  upgrade TOOL...  Bump mise tools to their newest release (both platforms)
  skills [sync|upgrade] [--prune]
            Sync global agent skills and plugins (default sync) or upgrade
            them; --prune removes skills no longer in the manifest
  agents sync [--global-only|--project-only]
            Translate config/agents, project .mcp.json and project skills
            into Claude Code, Codex and OpenCode config
  secret    Manage env vars / API keys (set, get, ls, rm, sync, import,
            reload, doctor)
EOF
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  t3)      shift; cmd_t3 "${1:-}" ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  skills)  shift; cmd_skills "$@" ;;
  agents)  shift; exec "$DOTFILES/bin/dots-agents" "$@" ;;
  secret)  shift; exec "$DOTFILES/bin/dots-secret" "$@" ;;
  -h|--help|help|"") usage ;;
  *) err "unknown command: $1"; usage; exit 1 ;;
esac
