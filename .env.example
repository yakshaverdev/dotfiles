# Bootstrap values — copy to ~/.env and fill in real values
# NEVER commit the real ~/.env file
# API keys go in Infisical via `dots secret set`, never in ~/.env.

# Git identity: `dots install` writes ~/.config/git/identity from these.
# Full name only (e.g. "Ada Lovelace") — never an email address.
export GIT_USER_NAME="Your Name"
export GIT_USER_EMAIL="you@example.com"
