{
  "addProjectBaseDirectory": "~/code",
  "autoResumeLimitedThreads": true,
  "defaultAutoPull": true,
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-opus-5-5"
  },
  "deviceOnboardingCompleted": true,
  "enableAgentDeviceAccess": true,
  "enableDeviceSupport": true,
  "favorites": [
    {
      "model": "gpt-5.6-sol",
      "provider": "codex"
    },
    {
      "model": "claude-fable-5",
      "provider": "claudeAgent"
    }
  ],
  "guestSharingEnabled": true,
  "idleCompaction": "onReturn",
  "linkedEnvironmentsEnabled": true,
  "projectSettingsFolded": true,
  "promptSuggestionsEnabled": true,
  "providerInstances": {
    "claudeAgent": {
      "driver": "claudeAgent"
    },
    "opencode": {
      "displayName": "OpenCode",
      "driver": "opencode",
      "enabled": true
    }
  },
  "pullRequestMergeMethod": "squash",
  "removeAgentCreditsOnMerge": true,
  "reviewGuideModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      }
    ]
  },
  "reviewGuidesEnabled": true,
  "sidebarAutoSettleKeepPullRequests": true,
  "simlockDeviceHostsEnabled": true,
  "snoozeLimitedThreads": true,
  "sourceControlWriterModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      }
    ]
  },
  "storageCleanup": {
    "worktreeSettledAfterDays": 8
  }
}
