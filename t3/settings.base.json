{
  "addProjectBaseDirectory": "~/code",
  "autoResumeLimitedThreads": true,
  "defaultAutoPull": true,
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-opus-5-5"
  },
  "defaultThreadEnvMode": "worktree",
  "deviceOnboardingCompleted": true,
  "enableAgentDeviceAccess": true,
  "enableDeviceSupport": true,
  "favorites": [
    {
      "model": "gpt-5.6-sol",
      "provider": "codex"
    },
    {
      "model": "claude-opus-5-5",
      "provider": "claudeAgent"
    }
  ],
  "guestSharingEnabled": true,
  "idleCompaction": "onReturn",
  "linkedEnvironmentsEnabled": true,
  "projectSettingsFolded": true,
  "promptSuggestionsEnabled": true,
  "providerInstances": {
    "claudeAgent": {
      "driver": "claudeAgent",
      "config": {
        "binaryPath": "~/.local/bin/claude-ctx"
      }
    },
    "grok": {
      "config": {
        "binaryPath": "grok",
        "customModels": []
      },
      "driver": "grok",
      "enabled": true
    },
    "opencode": {
      "config": {
        "binaryPath": "opencode",
        "customModels": [],
        "serverUrl": ""
      },
      "displayName": "OpenCode",
      "driver": "opencode",
      "enabled": true
    }
  },
  "pullRequestMergeMethod": "squash",
  "removeAgentCreditsOnMerge": true,
  "reviewGuideModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      }
    ]
  },
  "reviewGuidesEnabled": true,
  "sidebarAutoSettleKeepPullRequests": true,
  "simlockDeviceHostsEnabled": true,
  "snoozeLimitedThreads": true,
  "sourceControlWriterModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      }
    ]
  },
  "speechModelId": "handy-computer/nemotron-3.5-asr-streaming-0.6b-gguf",
  "speechPostProcessingModelSelection": {
    "instanceId": "codex",
    "model": "gpt-6-luna",
    "options": [
      {
        "id": "reasoningEffort",
        "value": "low"
      }
    ]
  },
  "storageCleanup": {
    "browserArtifactsAfterDays": 8,
    "logsAfterDays": 8,
    "worktreeAfterDays": 8,
    "worktreeOnDelete": true,
    "worktreeOnMerge": true,
    "worktreeSettledAfterDays": 8,
    "worktreeUnchanged": true
  }
}
